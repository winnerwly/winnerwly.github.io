:root
  --surface-blur: blur(14px)
  --content-width: 1060px
  --header-height: 72px

html
  scroll-behavior: smooth

body
  font-size: 16px
  line-height: 1.8
  letter-spacing: 0.01em

  &:before
    opacity: 1
    z-index: -2
    background-image: radial-gradient(circle at 10% 20%, rgba(148, 163, 184, 0.18), transparent 28%), radial-gradient(circle at 90% 0%, rgba(59, 130, 246, 0.16), transparent 36%), linear-gradient(180deg, rgba(255, 255, 255, 0.74), rgba(242, 245, 251, 0.98) 52%)

  &:after
    content: ''
    position: fixed
    inset: 0
    z-index: -1
    pointer-events: none
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.34), rgba(241, 245, 249, 0.08))

a
  transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease

.wrapper
  overflow: clip

.container
  max-width: 1200px
  margin: 0 auto
  padding-left: 1.25rem
  padding-right: 1.25rem

.navbar,
.navbar-mobile
  position: sticky
  top: 0
  z-index: 40
  height: auto
  line-height: 1.3
  border-bottom: 1px solid rgba(148, 163, 184, 0.32)
  background: rgba(255, 255, 255, 0.74)
  backdrop-filter: var(--surface-blur)
  -webkit-backdrop-filter: var(--surface-blur)

.navbar
  .container
    min-height: var(--header-height)
    display: flex
    align-items: center
    justify-content: space-between
    gap: 1rem

  .header-logo a
    font-weight: 700
    letter-spacing: 0.08em

  .menu
    display: flex
    align-items: center
    justify-content: flex-end
    gap: 0.35rem

    a
      display: inline-flex
      align-items: center
      min-height: 2.35rem
      padding: 0 0.9rem
      border-radius: 999px
      color: $light-font-secondary-color

      &:hover
        color: $light-navbar-active-color
        background: rgba(15, 23, 42, 0.08)

  .menu.active,
  .menu .active,
  .menu-item.active
    color: $light-navbar-active-color
    background: rgba(15, 23, 42, 0.08)

.navbar-actions
  display: flex
  align-items: center
  gap: 0.65rem

.theme-toggle
  min-height: 2.25rem
  padding: 0 0.75rem
  border-radius: 999px
  border: 1px solid rgba(148, 163, 184, 0.46)
  background: rgba(255, 255, 255, 0.6)
  color: $light-font-secondary-color
  font-size: 0.72rem
  letter-spacing: 0.09em
  font-weight: 600

  &:hover
    color: $light-font-color
    border-color: rgba(59, 130, 246, 0.42)
    background: rgba(59, 130, 246, 0.09)

.main
  padding-top: 2rem
  padding-bottom: 3rem

.main .container
  min-height: auto

.home-page .main
  padding-top: 1.5rem

.home-shell
  min-height: calc(100vh - 180px)

.post-wrap
  width: 100%
  max-width: var(--content-width)
  margin: 1rem auto 2.5rem
  padding: 2rem 2.2rem
  border-radius: $radius-lg
  border: 1px solid rgba(148, 163, 184, 0.26)
  background: $light-card-background
  box-shadow: $shadow-md
  backdrop-filter: var(--surface-blur)
  -webkit-backdrop-filter: var(--surface-blur)

.archive
  .archive-item
    margin-left: 0
    margin-top: 0.65rem
    padding: 1rem 1.2rem
    border-radius: $radius-md
    border: 1px solid rgba(148, 163, 184, 0.24)
    background: rgba(255, 255, 255, 0.64)
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease

    &:hover
      transform: translateY(-2px)
      border-color: rgba(59, 130, 246, 0.36)
      box-shadow: $shadow-sm

.archive-item-link
  max-width: calc(100% - 8.5rem)
  line-height: 1.5

.archive-item-date
  font-size: 0.82rem
  letter-spacing: 0.03em

.categories-card
  display: grid
  gap: 1rem
  padding: 0 !important

  .card-item
    margin-top: 0 !important
    padding: 1.2rem !important
    border-radius: $radius-md
    border: 1px solid rgba(148, 163, 184, 0.22)
    background: rgba(255, 255, 255, 0.68)

    .categories h3
      margin-top: 0

.tag-cloud-tags
  display: flex
  flex-wrap: wrap
  gap: 0.65rem
  margin-top: 1.25rem
  padding-top: 0

  a
    margin: 0
    padding: 0.52rem 0.82rem
    border-radius: 999px
    border: 1px solid rgba(148, 163, 184, 0.34)
    background: rgba(255, 255, 255, 0.75)
    font-size: 0.88rem

    &:hover
      transform: translateY(-1px)
      border-color: rgba(59, 130, 246, 0.5)
      background: rgba(59, 130, 246, 0.08)

.post-title
  line-height: 1.3

.post-meta
  display: flex
  flex-wrap: wrap
  gap: 0.5rem 1rem
  margin-top: 0.8rem
  font-size: 0.85rem
  color: $light-font-secondary-color !important

  br
    display: none

.post-content
  padding-top: 1.45rem
  text-align: left
  line-height: 1.85
  font-size: 1.02rem

  h2, h3, h4, h5, h6
    margin-top: 2.3rem
    margin-bottom: 1rem
    line-height: 1.35
    scroll-margin-top: calc(var(--header-height) + 16px)

  p
    margin: 0.9rem 0

  ul, ol
    padding-left: 1.55rem

  li + li
    margin-top: 0.45rem

  a
    border-bottom: 1px solid rgba(59, 130, 246, 0.35)

    &:hover
      border-bottom-color: rgba(59, 130, 246, 0.7)

  blockquote
    margin: 1.25rem 0
    padding: 0.9rem 1.1rem
    border-left: 3px solid $light-post-blockquote-border-color
    border-radius: 0 $radius-sm $radius-sm 0

  code
    padding: 0.16rem 0.42rem
    border-radius: 6px

  figure.highlight
    margin: 1.2rem 0
    border-radius: $radius-sm
    border: 1px solid rgba(148, 163, 184, 0.32)
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32)

  table
    overflow: hidden
    border-radius: $radius-sm

    th, td
      padding: 0.62rem 0.85rem

  img
    margin: 1.15rem auto
    border-radius: $radius-sm
    border: 1px solid rgba(148, 163, 184, 0.35)
    box-shadow: $shadow-sm

.post-toc
  top: calc(var(--header-height) + 40px)
  right: 1rem
  width: 16.5rem

  .tocbot-list
    max-height: calc(100vh - 170px)
    padding: 0.75rem
    border-radius: $radius-md
    border: 1px solid rgba(148, 163, 184, 0.24)
    background: rgba(255, 255, 255, 0.74)
    backdrop-filter: var(--surface-blur)

  .tocbot-list-menu
    margin: 0.75rem 0.25rem 0

.pagination
  gap: 0.45rem
  padding-top: 1.6rem

  a, span
    min-width: 2.2rem
    min-height: 2.2rem
    padding: 0.25rem 0.65rem
    border-radius: 999px
    border: 1px solid rgba(148, 163, 184, 0.34)
    background: rgba(255, 255, 255, 0.75)
    color: $light-font-secondary-color
    font-size: 0.8rem
    font-weight: 600
    letter-spacing: 0.02em
    display: inline-flex
    align-items: center
    justify-content: center

  .page-number
    margin: 0

    &:before, &:after
      display: none

    &.current
      color: #ffffff
      border-color: $primary-color
      background: $primary-color

.footer
  height: auto
  padding: 1.5rem 0 2.2rem

.copyright
  font-size: 0.82rem
  color: $light-font-secondary-color

.dark-theme
  body
    color: $dark-font-color

    &:before
      background-image: radial-gradient(circle at 14% 10%, rgba(96, 165, 250, 0.22), transparent 34%), radial-gradient(circle at 100% 0%, rgba(56, 189, 248, 0.16), transparent 33%), linear-gradient(180deg, #0b1220, #0f1a2d 56%)

    &:after
      background: linear-gradient(120deg, rgba(30, 41, 59, 0.5), rgba(15, 23, 42, 0.16))

  .navbar,
  .navbar-mobile
    border-bottom-color: rgba(148, 163, 184, 0.2)
    background: rgba(11, 18, 32, 0.76)

  .navbar .menu a,
  .theme-toggle,
  .archive-item-date,
  .post-meta,
  .copyright,
  .tag-cloud-tags a small
    color: $dark-font-secondary-color !important

  .navbar .menu a:hover,
  .navbar .menu.active,
  .navbar .menu .active,
  .menu-item.active,
  .theme-toggle:hover
    color: $dark-font-color !important

  .navbar .menu a:hover,
  .navbar .menu.active,
  .menu-item.active,
  .theme-toggle:hover,
  .post-content a:hover
    background: rgba(59, 130, 246, 0.16)

  .post-wrap,
  .archive .archive-item,
  .categories-card .card-item,
  .tag-cloud-tags a,
  .pagination a,
  .pagination span,
  .post-toc .tocbot-list
    background: $dark-card-background
    border-color: rgba(148, 163, 184, 0.24)
    box-shadow: none

  .post-content,
  .post-content p,
  .archive-item-link,
  .tag-cloud-tags a,
  .post-content strong,
  .post-content th,
  .post-content td,
  .post-content li
    color: $dark-font-color

  .post-content code
    background: $dark-code-background-color
    color: $dark-code-font-color

  .post-content figure.highlight
    background: #0f1a2d

  .post-content blockquote
    border-left-color: $dark-post-blockquote-border-color
    background: $dark-post-blockquote-background-color

  .post-content table thead
    background: $dark-post-table-background-color

  .post-content table th,
  .post-content table td,
  .post-content img
    border-color: rgba(148, 163, 184, 0.24)

  .pagination .page-number.current
    color: #0f172a
    background: #bfdbfe
    border-color: #bfdbfe

@media screen and (max-width: 1023px)
  .navbar
    display: none

  .navbar-mobile
    display: block !important

    .container
      padding: 0.85rem 1rem

      .navbar-header
        display: flex
        align-items: center
        justify-content: space-between
        gap: 0.75rem

      .menu-toggle
        width: 2.4rem
        height: 2.4rem
        display: inline-flex
        align-items: center
        justify-content: center
        border-radius: 999px
        border: 1px solid rgba(148, 163, 184, 0.4)

      .menu
        transition: transform 0.25s ease
        position: fixed
        top: 0
        left: 0
        right: 0
        bottom: 0
        transform: translateX(100%)
        padding: 5rem 1.2rem 1.2rem
        background: rgba(242, 245, 251, 0.97)
        overflow-y: auto

        &.active
          transform: translateX(0)

        .menu-item-title
          margin-bottom: 1rem
          line-height: 1.5

        a.menu-item
          display: block
          margin: 0 0 0.6rem
          padding: 0.72rem 0.88rem
          border-radius: $radius-sm
          border: 1px solid rgba(148, 163, 184, 0.32)

        .menu-close
          margin-top: 1rem
          width: 100%
          min-height: 2.7rem
          border-radius: $radius-sm
          border: 1px solid rgba(148, 163, 184, 0.4)
          display: inline-flex
          align-items: center
          justify-content: center

  .dark-theme .navbar-mobile .container .menu
    background: rgba(11, 18, 32, 0.96)

@media screen and (max-width: 767px)
  .main
    padding-top: 1rem

  .post-wrap
    margin: 0.75rem auto 1.6rem
    padding: 1.3rem 1rem

  .archive .archive-item
    display: block

  .archive-item-link
    max-width: 100%
    white-space: normal

  .archive-item-date
    float: none
    display: block
    text-align: left
    margin-top: 0.3rem

  .post-content
    font-size: 0.97rem

  .categories-card .card-item
    padding: 1rem !important

  .footer
    padding-top: 1.1rem

@media screen and (max-width: 1279px)
  .post-toc
    display: none
