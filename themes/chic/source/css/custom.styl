html
  background: #07090d
  overflow-x: hidden
  &::-webkit-scrollbar-thumb
    background-color: rgba(255, 255, 255, 0.26)
    &:hover
      background-color: rgba(255, 255, 255, 0.42)

body
  min-width: 320px
  overflow-x: hidden
  background: #07090d
  color: #f7f9fc
  letter-spacing: 0
  font-size: 16px

  &:before
    display: none

  &:after
    content: ''
    position: fixed
    inset: 0
    z-index: -1
    pointer-events: none
    background: radial-gradient(circle at 18% 8%, rgba(49, 236, 134, 0.16), transparent 25%), radial-gradient(circle at 82% 10%, rgba(56, 189, 248, 0.10), transparent 24%), linear-gradient(180deg, rgba(255,255,255,0.04), transparent 320px)

a
  color: #f7f9fc
  &:hover
    color: #31ec86

.wrapper
  position: relative

.main
  flex: 1
  .container
    max-width: 1130px
    min-height: auto
    margin: 0 auto

$text-xs = 12px
$text-sm = 14px
$text-base = 16px
$text-lg = 18px
$text-xl = 20px
$text-2xl = 24px
$text-section = clamp(30px, 3vw, 36px)
$text-hero = clamp(46px, 5vw, 64px)
$radius-sm = 4px

.site-header
  position: sticky
  top: 0
  z-index: 70
  line-height: 1
  isolation: isolate

.site-nav
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)
  background: linear-gradient(180deg, rgba(7, 9, 13, 0.92), rgba(7, 9, 13, 0.78))
  backdrop-filter: blur(20px)
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18)

.site-nav-shell
  max-width: 1360px
  margin: 0 auto
  height: 68px
  display: grid
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr)
  align-items: center
  gap: 24px
  padding: 0 28px

.site-brand
  display: inline-flex
  align-items: center
  gap: 10px
  min-width: 0
  justify-self: start
  color: #f7f9fc
  text-decoration: none

  &:hover
    color: #f7f9fc

.site-brand-mark
  width: 34px
  height: 34px
  display: inline-flex
  align-items: center
  justify-content: center
  flex: 0 0 auto
  border: 1px solid rgba(49, 236, 134, 0.52)
  border-radius: 12px
  background: radial-gradient(circle at 35% 20%, rgba(49, 236, 134, 0.42), rgba(49, 236, 134, 0.10) 58%, rgba(255, 255, 255, 0.04))
  color: #31ec86
  font-size: $text-base
  font-weight: 900
  box-shadow: 0 14px 36px rgba(49, 236, 134, 0.10)

.site-brand-text
  display: inline-flex
  align-items: center
  gap: 2px
  min-width: 0
  color: #f7f9fc
  font-size: $text-xl
  font-weight: 900
  letter-spacing: 0
  white-space: nowrap

  span
    color: #31ec86

.site-nav-links
  display: flex
  align-items: center
  justify-content: center
  gap: 8px
  min-width: 0

.site-nav-link
  height: 40px
  display: inline-flex
  align-items: center
  gap: 8px
  padding: 0 13px
  border: 1px solid transparent
  border-radius: 999px
  color: rgba(247, 249, 252, 0.66)
  font-size: $text-sm
  font-weight: 800
  text-decoration: none
  white-space: nowrap
  transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.18s ease

  .nav-icon
    width: 17px
    height: 17px
    color: rgba(49, 236, 134, 0.74)
    fill: none
    flex: 0 0 auto
    stroke: currentColor
    stroke-linecap: round
    stroke-linejoin: round
    stroke-width: 2

  &:hover
    border-color: rgba(49, 236, 134, 0.26)
    background: rgba(49, 236, 134, 0.075)
    color: #f7f9fc
    transform: translateY(-1px)

    .nav-icon
      color: #31ec86

.site-nav-actions
  display: inline-flex
  align-items: center
  justify-content: flex-end
  justify-self: end
  gap: 10px

.theme-toggle,
.site-menu-toggle,
.site-menu-close
  height: 40px
  display: inline-flex
  align-items: center
  justify-content: center
  padding: 0 13px
  border: 1px solid rgba(255, 255, 255, 0.16)
  border-radius: 14px
  background: rgba(255, 255, 255, 0.055)
  color: #f7f9fc
  font-size: $text-sm
  font-weight: 900
  cursor: pointer
  transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease, transform 0.18s ease

  &:hover
    border-color: rgba(49, 236, 134, 0.48)
    background: rgba(49, 236, 134, 0.10)
    color: #31ec86
    transform: translateY(-1px)

.theme-toggle
  width: 40px
  min-width: 40px
  padding: 0

.theme-icon
  display: none
  width: 19px
  height: 19px
  fill: none
  stroke: currentColor
  stroke-linecap: round
  stroke-linejoin: round
  stroke-width: 2

.theme-toggle[data-theme-mode='dark'] .theme-icon-moon,
.theme-toggle[data-theme-mode='light'] .theme-icon-sun
  display: block

.site-menu-toggle
  display: none
  gap: 8px
  min-width: 88px

.site-menu-lines
  width: 16px
  height: 12px
  display: inline-flex
  flex-direction: column
  justify-content: space-between
  flex: 0 0 auto

  i
    display: block
    width: 100%
    height: 2px
    border-radius: 999px
    background: currentColor
    transition: transform 0.18s ease, opacity 0.18s ease

.site-menu-toggle.is-open
  .site-menu-lines
    i:first-child
      transform: translateY(5px) rotate(45deg)

    i:last-child
      transform: translateY(-5px) rotate(-45deg)

.site-mobile-menu
  position: fixed
  inset: 0
  z-index: 90
  opacity: 0
  pointer-events: none
  transition: opacity 0.2s ease

  &.is-open
    opacity: 1
    pointer-events: auto

    .site-mobile-panel
      transform: translateX(0)

.site-mobile-backdrop
  position: absolute
  inset: 0
  border: 0
  background: rgba(3, 6, 10, 0.58)
  backdrop-filter: blur(10px)
  cursor: pointer

.site-mobile-panel
  position: absolute
  top: 0
  right: 0
  width: min(420px, 100vw)
  height: 100vh
  height: 100dvh
  display: flex
  flex-direction: column
  gap: 12px
  padding: 16px
  overflow-y: auto
  background: radial-gradient(circle at 18% 0%, rgba(49, 236, 134, 0.16), transparent 30%), linear-gradient(180deg, #090d14 0%, #05080d 100%)
  box-shadow: -30px 0 90px rgba(0, 0, 0, 0.36)
  transform: translateX(105%)
  transition: transform 0.24s ease

.site-mobile-head
  min-height: 54px
  display: flex
  align-items: center
  justify-content: space-between
  gap: 14px
  padding-bottom: 12px
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)

.site-brand-mobile
  min-width: 0

.site-mobile-links
  display: grid
  gap: 10px

.site-mobile-link
  min-height: 58px
  display: flex
  align-items: center
  gap: 14px
  padding: 0 16px
  border: 1px solid rgba(255, 255, 255, 0.10)
  border-radius: 14px
  background: rgba(255, 255, 255, 0.05)
  color: #f7f9fc
  font-size: $text-base
  font-weight: 900
  text-decoration: none
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04)

  .nav-icon
    width: 20px
    height: 20px
    color: #31ec86
    fill: none
    flex: 0 0 auto
    stroke: currentColor
    stroke-linecap: round
    stroke-linejoin: round
    stroke-width: 2

  &:hover
    border-color: rgba(49, 236, 134, 0.42)
    background: rgba(49, 236, 134, 0.09)
    color: #31ec86

html.nav-menu-open,
body.nav-menu-open
  overflow: hidden

.home-template
  max-width: 1130px
  margin: 0 auto
  padding: 68px 24px 92px
  position: relative
  overflow: hidden

  &:before
    content: ''
    position: absolute
    top: 36px
    right: 20px
    width: 520px
    height: 520px
    z-index: -1
    opacity: 0.55
    background-image: linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px)
    background-size: 34px 34px
    mask-image: radial-gradient(circle, #000 0%, transparent 68%)

.home-hero
  min-height: 430px
  display: grid
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr)
  align-items: flex-start
  gap: 48px
  padding-top: 30px

  h1
    margin: 0
    max-width: 820px
    color: #f7f9fc
    font-size: $text-hero
    line-height: 1.14
    font-weight: 800

.home-hero-copy
  align-self: center
  min-width: 0

.home-eyebrow
  margin: 0 0 18px
  color: #31ec86
  font-size: $text-sm
  font-weight: 800
  letter-spacing: 0.08em
  text-transform: uppercase

.home-subtitle
  max-width: 740px
  margin: 22px 0 0
  color: #a9b3c3
  font-size: $text-lg
  line-height: 1.7

.home-actions
  display: flex
  flex-wrap: wrap
  gap: 14px
  margin-top: 34px

.home-action
  display: inline-flex
  align-items: center
  justify-content: center
  min-width: 214px
  height: 52px
  padding: 0 22px
  border: 1px solid rgba(255, 255, 255, 0.55)
  border-radius: $radius-sm
  box-shadow: 0 16px 44px rgba(0, 0, 0, 0.18)
  color: #f7f9fc
  font-size: $text-base
  font-weight: 800
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease, transform 0.2s ease

  &:hover
    border-color: #31ec86
    color: #31ec86
    transform: translateY(-2px)

  &.is-primary
    border-color: #31ec86
    background: #31ec86
    color: #061009
    box-shadow: 0 18px 56px rgba(49, 236, 134, 0.18)

    &:hover
      background: #62f3a5
      color: #061009

.home-visual
  align-self: center
  justify-self: end
  position: relative
  width: min(100%, 390px)
  min-height: 390px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025))
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 34px 90px rgba(0, 0, 0, 0.32)
  overflow: hidden

  &:before
    content: ''
    position: absolute
    inset: 18px
    border: 1px solid rgba(49, 236, 134, 0.18)
    border-radius: $radius-sm
    background-image: linear-gradient(rgba(49, 236, 134, 0.10) 1px, transparent 1px), linear-gradient(90deg, rgba(49, 236, 134, 0.10) 1px, transparent 1px)
    background-size: 28px 28px
    opacity: 0.72

  &:after
    content: ''
    position: absolute
    left: -20%
    right: -20%
    top: 44%
    height: 1px
    background: linear-gradient(90deg, transparent, rgba(49, 236, 134, 0.8), transparent)
    transform: rotate(-12deg)

.visual-orbit
  position: absolute
  inset: 42px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm

  span
    position: absolute
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 48px
    height: 34px
    padding: 0 10px
    border: 1px solid rgba(49, 236, 134, 0.38)
    border-radius: $radius-sm
    background: rgba(7, 9, 13, 0.78)
    color: #31ec86
    font-size: $text-xs
    font-weight: 900

    &:nth-child(1)
      top: -17px
      left: 26px

    &:nth-child(2)
      right: -18px
      top: 92px

    &:nth-child(3)
      left: 74px
      bottom: -17px

.visual-terminal
  position: absolute
  left: 54px
  right: 42px
  top: 122px
  min-height: 142px
  padding: 18px
  border: 1px solid rgba(255, 255, 255, 0.16)
  border-radius: $radius-sm
  background: rgba(5, 8, 12, 0.84)
  backdrop-filter: blur(12px)

  p,
  small
    margin: 0
    color: #8d98aa
    font-size: $text-xs
    font-weight: 800
    line-height: 1.7

  strong
    display: block
    margin: 16px 0 8px
    color: #f7f9fc
    font-size: $text-2xl
    line-height: 1.2

.visual-bar
  display: flex
  gap: 7px
  margin-bottom: 18px

  i
    width: 8px
    height: 8px
    border-radius: 50%
    background: rgba(255, 255, 255, 0.28)

    &:first-child
      background: #31ec86

.visual-flow
  position: absolute
  left: 32px
  right: 32px
  bottom: 34px
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 8px

  span
    min-width: 0
    padding: 10px 8px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    background: rgba(255, 255, 255, 0.04)
    color: #a9b3c3
    font-size: $text-xs
    font-weight: 800
    text-align: center

.home-stats
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 14px
  width: 100%
  grid-column: 1 / -1
  margin-top: 48px

  div
    position: relative
    overflow: hidden
    padding: 18px 20px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025))

    &:before
      content: ''
      position: absolute
      left: 0
      top: 0
      width: 3px
      height: 100%
      background: #31ec86
      opacity: 0.86

  strong
    display: block
    color: #f7f9fc
    font-size: $text-2xl
    line-height: 1.2

  span
    display: block
    margin-top: 8px
    color: #8d98aa
    font-size: $text-sm
    font-weight: 700

.home-section
  margin-top: 76px
  padding-top: 38px
  border-top: 1px solid rgba(255, 255, 255, 0.12)

.home-section-head
  display: flex
  align-items: flex-start
  justify-content: space-between
  gap: 24px
  margin-bottom: 30px

  h2
    margin: 0
    color: #f7f9fc
    font-size: $text-section
    line-height: 1.2
    font-weight: 800

  p
    max-width: 430px
    margin: 0
    color: #909bad
    font-size: $text-base
    line-height: 1.7

.section-kicker
  margin: 0 0 10px !important
  color: #31ec86 !important
  font-size: $text-xs !important
  font-weight: 800
  letter-spacing: 0.08em
  line-height: 1.4 !important
  text-transform: uppercase

.section-more
  flex: 0 0 auto
  color: #f7f9fc
  font-size: $text-sm
  font-weight: 800

  &:hover
    color: #31ec86

.topic-grid
  display: grid
  grid-template-columns: repeat(4, minmax(0, 1fr))
  gap: 18px

.topic-card
  position: relative
  overflow: hidden
  min-height: 260px
  display: flex
  flex-direction: column
  padding: 24px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.025))
  transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease

  &:before
    content: ''
    position: absolute
    inset: 0 0 auto
    height: 3px
    background: linear-gradient(90deg, #31ec86, rgba(56, 189, 248, 0.72), transparent)
    opacity: 0
    transition: opacity 0.2s ease

  &:hover
    border-color: rgba(49, 236, 134, 0.42)
    background: linear-gradient(180deg, rgba(49, 236, 134, 0.08), rgba(255, 255, 255, 0.035))
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22)
    transform: translateY(-4px)

    &:before
      opacity: 1

  h3
    margin: 22px 0 0
    color: #f7f9fc
    font-size: $text-xl
    line-height: 1.35
    font-weight: 800

  p
    margin: 14px 0 0
    color: #a9b3c3
    font-size: $text-base
    line-height: 1.7

  a
    margin-top: auto
    padding-top: 22px
    color: #f7f9fc
    font-size: $text-sm
    font-weight: 800

    &:hover
      color: #31ec86

.topic-index
  display: inline-flex
  align-items: center
  justify-content: center
  width: 34px
  height: 34px
  border: 1px solid rgba(255, 255, 255, 0.22)
  border-radius: $radius-sm
  color: #31ec86
  font-size: $text-xs
  font-weight: 800
  background: rgba(49, 236, 134, 0.06)

.latest-list
  border-top: 1px solid rgba(255, 255, 255, 0.10)

.latest-row
  position: relative
  min-height: 82px
  display: grid
  grid-template-columns: 136px minmax(0, 1fr) 220px
  align-items: center
  gap: 24px
  padding: 0 18px
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)
  color: #f7f9fc
  transition: background 0.2s ease, color 0.2s ease, padding-left 0.2s ease

  &:hover
    background: rgba(49, 236, 134, 0.055)
    color: #31ec86
    padding-left: 28px

    &:before
      opacity: 1

  &:before
    content: ''
    position: absolute
    left: 0
    top: 18px
    bottom: 18px
    width: 3px
    background: #31ec86
    opacity: 0
    transition: opacity 0.2s ease

  time
    color: #8d98aa
    font-size: $text-sm
    font-weight: 800

.latest-title
  min-width: 0
  overflow: hidden
  color: inherit
  font-size: $text-lg
  line-height: 1.5
  text-overflow: ellipsis
  white-space: nowrap

.latest-tags
  display: flex
  flex-wrap: wrap
  justify-content: flex-end
  gap: 8px

  em
    display: inline-flex
    max-width: 96px
    overflow: hidden
    padding: 6px 9px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    color: #9aa5b6
    font-size: $text-xs
    font-style: normal
    font-weight: 800
    line-height: 1.2
    text-overflow: ellipsis
    white-space: nowrap

.site-link-grid
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 14px

.site-link-card
  position: relative
  display: flex
  flex-direction: column
  min-height: 116px
  padding: 22px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm
  background: rgba(255, 255, 255, 0.03)
  color: #f7f9fc
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease, transform 0.2s ease

  &:after
    content: '→'
    position: absolute
    right: 20px
    top: 20px
    color: rgba(49, 236, 134, 0.72)
    font-size: $text-lg
    line-height: 1
    transform: translateX(-4px)
    opacity: 0
    transition: opacity 0.2s ease, transform 0.2s ease

  strong
    color: inherit
    font-size: $text-lg
    line-height: 1.3

  span
    margin-top: 12px
    color: #9aa5b6
    font-size: $text-sm
    line-height: 1.6

  &:hover
    border-color: rgba(49, 236, 134, 0.6)
    background: rgba(49, 236, 134, 0.055)
    color: #31ec86
    transform: translateY(-2px)

    &:after
      opacity: 1
      transform: translateX(0)

.post-wrap,
.archive,
.categories-card,
.tag-cloud
  max-width: 980px
  margin: 56px auto
  padding: 36px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm
  background: rgba(255, 255, 255, 0.03)

.archive h3,
.post-title
  margin: 0 0 28px
  color: #f7f9fc
  font-size: $text-section
  line-height: 1.2
  font-weight: 800

.archive .archive-item
  margin-left: 0
  padding: 18px 0
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)

.archive-item-link
  color: #f7f9fc
  font-size: $text-lg
  line-height: 1.5

.archive-item-date,
.post-meta
  color: #8d98aa
  font-size: $text-sm

.post-content
  color: #d8dee8
  font-size: $text-base
  line-height: 1.9

  h2, h3, h4
    color: #f7f9fc
    line-height: 1.25

  h2
    font-size: $text-2xl

  h3
    font-size: $text-xl

  h4
    font-size: $text-lg

  p, ul, ol
    color: #c4ccd8

  a
    color: #31ec86
    border-bottom: 1px solid rgba(49, 236, 134, 0.34)

  code
    padding: 2px 7px
    background: rgba(255, 255, 255, 0.08)
    color: #f7f9fc
    border-radius: 4px

  figure.highlight,
  blockquote
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    background: rgba(255, 255, 255, 0.04)

.tag-cloud-tags
  display: flex
  flex-wrap: wrap
  gap: 12px

  a
    margin: 0
    padding: 9px 14px
    border: 1px solid rgba(255, 255, 255, 0.14)
    border-radius: $radius-sm
    color: #f7f9fc

    &:hover
      border-color: #31ec86
      color: #31ec86

.footer
  height: auto
  padding: 30px 20px
  border-top: 1px solid rgba(255, 255, 255, 0.08)
  line-height: 1.5

.copyright
  color: #7e8899
  font-size: $text-sm

.light-theme
  background: #f4f7fb

  body
    background: #f4f7fb
    color: #101722

    &:after
      background: radial-gradient(circle at 50% 0%, rgba(49, 236, 134, 0.18), transparent 30%), linear-gradient(180deg, rgba(255,255,255,0.9), transparent 280px)

  a
    color: #101722

  .site-nav
    background: rgba(255, 255, 255, 0.9)
    border-bottom-color: rgba(16, 23, 34, 0.10)
    box-shadow: 0 16px 40px rgba(16, 23, 34, 0.08)

  .site-brand-text,
  .home-hero h1,
  .home-section-head h2,
  .home-stats strong,
  .topic-card h3,
  .latest-title,
  .site-link-card strong,
  .archive h3,
  .post-title
    color: #101722

  .site-brand:hover
    color: #101722

  .site-brand-mark
    border-color: rgba(21, 215, 118, 0.38)
    background: rgba(21, 215, 118, 0.10)
    color: #0f9f5a

  .site-nav-link
    color: #5b6676

    &:hover
      border-color: rgba(21, 215, 118, 0.28)
      background: rgba(21, 215, 118, 0.08)
      color: #101722

  .theme-toggle,
  .site-menu-toggle,
  .site-menu-close
    border-color: rgba(16, 23, 34, 0.14)
    background: #ffffff
    color: #101722

    &:hover
      border-color: rgba(21, 215, 118, 0.65)
      background: rgba(21, 215, 118, 0.08)
      color: #0f9f5a

  .home-subtitle,
  .home-section-head p,
  .home-stats span,
  .topic-card p,
  .latest-row time,
  .latest-tags em,
  .site-link-card span,
  .archive-item-date,
  .post-meta,
  .copyright
    color: #657184

  .home-action
    color: #101722
    border-color: rgba(16, 23, 34, 0.32)

  .home-action.is-primary
    border-color: #15d776
    background: #15d776
    color: #061009

  .home-template:before
    background-image: linear-gradient(rgba(16, 23, 34, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(16, 23, 34, 0.07) 1px, transparent 1px)

  .home-visual
    border-color: rgba(16, 23, 34, 0.12)
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(235, 241, 248, 0.72))
    box-shadow: 0 30px 80px rgba(16, 23, 34, 0.12)

    &:before
      border-color: rgba(21, 215, 118, 0.22)
      background-image: linear-gradient(rgba(21, 215, 118, 0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(21, 215, 118, 0.12) 1px, transparent 1px)

  .visual-orbit
    border-color: rgba(16, 23, 34, 0.12)

    span
      background: rgba(255, 255, 255, 0.84)
      color: #0fa85c

  .visual-terminal
    border-color: rgba(16, 23, 34, 0.12)
    background: rgba(255, 255, 255, 0.86)

    strong
      color: #101722

    p,
    small
      color: #657184

  .visual-flow span
    border-color: rgba(16, 23, 34, 0.12)
    background: rgba(255, 255, 255, 0.72)
    color: #657184

  .home-section,
  .home-stats div,
  .topic-card,
  .latest-list,
  .latest-row,
  .latest-tags em,
  .site-link-card,
  .post-wrap,
  .archive,
  .categories-card,
  .tag-cloud,
  .footer
    border-color: rgba(16, 23, 34, 0.12)

  .post-wrap,
  .archive,
  .categories-card,
  .tag-cloud
    background: rgba(255, 255, 255, 0.72)

  .home-stats div,
  .topic-card,
  .site-link-card
    background: rgba(255, 255, 255, 0.72)

  .topic-card:hover,
  .site-link-card:hover,
  .latest-row:hover
    background: rgba(21, 215, 118, 0.08)

  .latest-title,
  .archive-item-link,
  .post-content,
  .post-content h2,
  .post-content h3,
  .post-content h4
    color: #101722

  .post-content p,
  .post-content ul,
  .post-content ol
    color: #3d4756

  .site-mobile-backdrop
    background: rgba(16, 23, 34, 0.38)

  .site-mobile-panel
    background: radial-gradient(circle at 18% 0%, rgba(21, 215, 118, 0.12), transparent 28%), linear-gradient(180deg, #ffffff 0%, #f5f8fc 100%)
    box-shadow: -30px 0 90px rgba(16, 23, 34, 0.16)

  .site-mobile-head
    border-bottom-color: rgba(16, 23, 34, 0.10)

  .site-mobile-link
    color: #101722
    border-color: rgba(16, 23, 34, 0.10)
    background: rgba(255, 255, 255, 0.78)

    .nav-icon
      color: #15b966

    &:hover
      border-color: rgba(21, 215, 118, 0.36)
      background: rgba(21, 215, 118, 0.08)
      color: #0f9f5a

@media (max-width: 1023px)
  .site-nav-shell
    height: 62px
    grid-template-columns: minmax(0, 1fr) auto
    gap: 12px
    padding: 0 14px

  .site-nav-links
    display: none

  .site-brand
    overflow: hidden

  .site-brand-mark
    width: 32px
    height: 32px
    border-radius: 11px
    font-size: $text-sm

  .site-brand-text
    max-width: 48vw
    overflow: hidden
    font-size: $text-lg
    text-overflow: ellipsis

  .site-nav-actions
    gap: 8px

  .theme-toggle
    width: 38px
    min-width: 38px
    height: 38px
    border-radius: 12px

    .theme-icon
      width: 18px
      height: 18px

  .site-menu-toggle
    display: inline-flex
    width: 86px
    min-width: 86px
    height: 38px
    border-radius: 12px
    white-space: nowrap

  .site-menu-close
    height: 38px
    padding: 0 12px
    border-radius: 12px

  .site-mobile-panel
    width: 100vw
    padding: 16px

  .site-mobile-link
    min-height: 58px
    border-radius: 13px

  .home-template
    padding-top: 42px

  .home-hero
    grid-template-columns: 1fr
    min-height: 360px
    gap: 28px

  .home-visual
    justify-self: stretch
    width: 100%
    min-height: 300px

  .visual-terminal
    left: 42px
    right: 42px
    top: 88px

  .topic-grid
    grid-template-columns: repeat(2, minmax(0, 1fr))

  .latest-row
    grid-template-columns: 120px minmax(0, 1fr)

  .latest-tags
    grid-column: 2
    justify-content: flex-start

  .site-link-grid
    grid-template-columns: repeat(2, minmax(0, 1fr))

@media (max-width: 720px)
  .main
    padding-top: 0

  .home-template
    padding-left: 18px
    padding-right: 18px

  .home-hero
    min-height: 0
    padding-top: 28px

    h1
      max-width: 100%
      font-size: clamp(40px, 13vw, 54px)

  .home-subtitle
    max-width: 100%

  .home-actions
    width: 100%

  .home-action
    width: 100%
    min-width: 0

  .home-stats
    grid-template-columns: 1fr

  .home-visual
    min-height: 238px

  .visual-orbit
    inset: 26px

  .visual-terminal
    left: 28px
    right: 28px
    top: 70px
    min-height: 112px
    padding: 14px

    strong
      margin: 10px 0 4px
      font-size: $text-xl

  .visual-flow
    left: 20px
    right: 20px
    bottom: 22px

    span
      padding: 8px 4px

  .home-section
    margin-top: 56px
    padding-top: 30px

  .home-section-head
    flex-direction: column

  .topic-grid,
  .site-link-grid
    grid-template-columns: 1fr

  .topic-card
    min-height: 0

  .latest-row
    grid-template-columns: 1fr
    gap: 6px
    padding: 18px 0

    &:hover
      padding-left: 12px

  .latest-title
    white-space: normal

  .latest-tags
    grid-column: auto
    justify-content: flex-start

  .post-wrap,
  .archive,
  .categories-card,
  .tag-cloud
    margin: 28px auto
    padding: 22px 18px

/* unified inner pages */
.content-shell,
.article-shell
  max-width: 1130px
  margin: 0 auto
  padding: 58px 24px 88px

.content-hero
  padding: 0 0 34px
  border-bottom: 1px solid rgba(255, 255, 255, 0.12)

  h1
    max-width: 760px
    margin: 0
    color: #f7f9fc
    font-size: $text-hero
    line-height: 1.14
    font-weight: 800

  p
    max-width: 720px
    margin: 18px 0 0
    color: #a9b3c3
    font-size: $text-lg
    line-height: 1.7

.content-kicker
  margin: 0 0 16px !important
  color: #31ec86 !important
  font-size: $text-sm !important
  font-weight: 800
  line-height: 1.4 !important
  letter-spacing: 0.08em
  text-transform: uppercase

.content-stats
  display: flex
  flex-wrap: wrap
  gap: 12px
  margin-top: 26px

  span
    display: inline-flex
    align-items: center
    gap: 8px
    min-height: 38px
    padding: 0 14px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    color: #8d98aa
    font-size: $text-sm
    font-weight: 700
    line-height: 1

  strong
    color: #f7f9fc
    font-size: $text-xl
    line-height: 1

.timeline-panel,
.content-panel,
.tag-cloud-panel
  margin-top: 34px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm
  background: rgba(255, 255, 255, 0.03)

.timeline-panel
  padding: 10px 28px 28px

.archive-year
  margin: 34px 0 10px
  color: #31ec86
  font-size: $text-2xl
  line-height: 1.2
  font-weight: 800

.archive-entry
  min-height: 74px
  display: grid
  grid-template-columns: minmax(0, 1fr) 128px
  align-items: center
  gap: 24px
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)

  &:last-of-type
    border-bottom: 0

.archive-entry-title
  min-width: 0
  overflow: hidden
  color: #f7f9fc
  font-size: $text-lg
  line-height: 1.55
  text-overflow: ellipsis
  white-space: nowrap

  &:hover
    color: #31ec86

.archive-entry-date
  justify-self: end
  color: #8d98aa
  font-size: $text-sm
  font-weight: 800

.taxonomy-grid
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 18px
  margin-top: 34px

.taxonomy-card
  min-height: 238px
  display: flex
  flex-direction: column
  padding: 24px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm
  background: rgba(255, 255, 255, 0.03)

  > a
    display: block
    color: #f7f9fc

    &:hover
      color: #31ec86

  h2
    margin: 18px 0 0
    color: inherit
    font-size: $text-2xl
    line-height: 1.25

  p
    margin: 12px 0 0
    color: #9aa5b6
    font-size: $text-base
    line-height: 1.7

.taxonomy-count
  display: inline-flex
  align-items: center
  min-height: 32px
  padding: 0 10px
  border: 1px solid rgba(49, 236, 134, 0.38)
  border-radius: $radius-sm
  color: #31ec86
  font-size: $text-sm
  font-weight: 800

.taxonomy-preview
  display: grid
  gap: 10px
  margin-top: auto
  padding-top: 22px

  a
    min-width: 0
    overflow: hidden
    color: #a9b3c3
    font-size: $text-sm
    line-height: 1.5
    text-overflow: ellipsis
    white-space: nowrap

    &:hover
      color: #31ec86

.tag-cloud-panel
  display: flex
  flex-wrap: wrap
  gap: 12px
  padding: 26px

  a
    display: inline-flex
    align-items: center
    gap: 10px
    min-height: 40px
    padding: 0 14px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    color: #f7f9fc
    font-size: $text-base
    font-weight: 700

    &:hover
      border-color: rgba(49, 236, 134, 0.7)
      color: #31ec86

    small
      color: #8d98aa
      font-size: $text-xs
      font-weight: 800

.content-panel
  padding: 34px

.readable-page
  max-width: 860px

.ins-content
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 18px
  user-select: none

  p
    margin: 0
    display: contents

  img
    display: block
    width: 100%
    height: 100%
    aspect-ratio: 4 / 3
    object-fit: cover
    border: 1px solid rgba(255, 255, 255, 0.14)
    border-radius: $radius-sm
    background: rgba(255, 255, 255, 0.04)

.friends-panel blockquote
  margin: 0
  padding: 20px 22px
  border: 1px solid rgba(49, 236, 134, 0.24)
  border-left: 3px solid #31ec86
  border-radius: $radius-sm
  background: rgba(49, 236, 134, 0.06)

.article-shell
  max-width: 980px

.article-panel
  max-width: none
  margin: 0
  padding: 42px

.article-header
  padding-bottom: 30px
  border-bottom: 1px solid rgba(255, 255, 255, 0.12)

  .post-title
    margin: 0
    color: #f7f9fc
    font-size: clamp(34px, 4vw, 52px)
    line-height: 1.18
    font-weight: 800

.article-meta
  display: flex
  flex-wrap: wrap
  gap: 10px 18px
  margin-top: 22px
  color: #8d98aa
  font-size: $text-sm
  line-height: 1.7

  a
    color: #f7f9fc

    &:hover
      color: #31ec86

.article-tags
  display: flex
  flex-wrap: wrap
  gap: 10px
  margin-top: 20px

  a
    display: inline-flex
    align-items: center
    min-height: 34px
    padding: 0 11px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    color: #a9b3c3
    font-size: $text-sm
    font-weight: 700

    &:hover
      border-color: rgba(49, 236, 134, 0.7)
      color: #31ec86

.article-content
  padding-top: 34px

  > h1:first-child
    display: none

  h2
    margin: 44px 0 16px
    padding-top: 8px

  h3
    margin: 34px 0 14px

  p
    margin: 16px 0
    line-height: 1.9

  ul, ol
    margin: 16px 0
    padding-left: 1.4em
    line-height: 1.9

  li + li
    margin-top: 8px

  figure.highlight
    margin: 22px 0
    overflow-x: auto
    background: #05080c

    table
      width: auto
      min-width: 100%

    pre
      margin: 0
      padding: 14px 16px
      line-height: 1.7

  blockquote
    margin: 24px 0
    padding: 18px 22px
    border-left: 3px solid #31ec86

  table
    display: block
    width: 100%
    overflow-x: auto
    border-collapse: collapse

  th, td
    padding: 10px 12px

  img
    margin: 24px auto

.article-copyright
  margin-top: 34px
  padding: 18px 20px
  border: 1px solid rgba(255, 255, 255, 0.10)
  border-radius: $radius-sm
  color: #9aa5b6

.article-nav
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 14px
  margin-top: 32px

  &:before,
  &:after
    display: none
    content: none

  a.prev,
  a.next
    float: none
    min-height: 98px
    display: flex
    align-items: center
    gap: 10px
    justify-content: center
    padding: 18px 20px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: $radius-sm
    color: #f7f9fc
    font-size: $text-base
    font-weight: 800
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease

    &:before,
    &:after
      display: none

    &:hover
      border-color: rgba(49, 236, 134, 0.7)
      color: #31ec86
      transform: translateY(-2px)

    small
      flex: 0 0 auto
      color: #8d98aa
      font-size: $text-xs
      font-weight: 800

    span
      min-width: 0
      max-width: none
      width: auto
      line-height: 1.5
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

  a.next
    text-align: right

.post-toc
  position: fixed
  top: 88px
  right: 24px
  width: 220px
  padding: 16px
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: $radius-sm
  background: rgba(7, 9, 13, 0.86)
  backdrop-filter: blur(16px)
  font-size: $text-sm

.toc-title
  margin-bottom: 12px
  color: #f7f9fc
  font-size: $text-sm
  font-weight: 800

.post-toc .tocbot-list
  max-height: 52vh
  overflow: auto

  ul
    list-style: none
    padding-left: 0

  li
    margin: 6px 0

  a
    color: #9aa5b6
    line-height: 1.5

    &:hover
      color: #31ec86

.post-toc .is-active-link
  color: #31ec86

.post-toc .tocbot-list-menu
  display: flex
  gap: 10px
  margin-top: 14px

  a
    color: #8d98aa
    font-size: $text-xs
    font-weight: 800
    cursor: pointer

    &:hover
      color: #31ec86

.pagination
  display: flex
  flex-wrap: wrap
  justify-content: center
  align-items: center
  gap: 10px
  width: 100%
  max-width: 100%
  margin: 38px auto 0
  padding: 24px 0 4px
  border: 0
  border-top: 1px solid rgba(255, 255, 255, 0.08)
  border-radius: 0
  background: transparent
  box-shadow: none
  white-space: normal

  a,
  span
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 38px
    height: 38px
    margin: 0
    padding: 0 12px
    box-sizing: border-box
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: 10px
    background: rgba(255, 255, 255, 0.035)
    color: #98a4b5
    font-size: $text-sm
    font-weight: 800
    letter-spacing: 0
    line-height: 1
    text-decoration: none
    box-shadow: none
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.18s ease

    &:before,
    &:after
      display: none !important
      content: none !important

  .page-number
    position: static
    box-sizing: border-box
    margin: 0
    padding: 0 12px
    display: inline-flex

  .extend
    min-width: 46px
    color: #94a3b8
    font-size: $text-base
    font-weight: 800

  a:hover
    color: #31ec86
    border-color: rgba(49, 236, 134, 0.42)
    background: rgba(49, 236, 134, 0.08)
    transform: translateY(-1px)

  a:focus-visible
    outline: 2px solid rgba(49, 236, 134, 0.78)
    outline-offset: 2px

  .space
    min-width: 26px
    height: 34px
    padding: 0
    border-color: transparent
    background: transparent
    box-shadow: none
    color: #7a8596
    cursor: default
    pointer-events: none

  .current
    color: #061009
    background: #31ec86
    border-color: #31ec86
    box-shadow: 0 12px 28px rgba(49, 236, 134, 0.18)
    cursor: default

  .disabled
    color: #5f6876
    border-color: transparent
    background: transparent
    cursor: not-allowed
    pointer-events: none

.light-theme
  .content-hero
    border-bottom-color: rgba(16, 23, 34, 0.12)

    h1
      color: #101722

    p
      color: #657184

  .content-stats span,
  .timeline-panel,
  .content-panel,
  .tag-cloud-panel,
  .taxonomy-card,
  .archive-entry,
  .tag-cloud-panel a,
  .article-header,
  .article-tags a,
  .article-copyright,
  .article-nav a.prev,
  .article-nav a.next,
  .pagination a,
  .pagination span,
  .post-toc
    border-color: rgba(16, 23, 34, 0.12)

  .timeline-panel,
  .content-panel,
  .tag-cloud-panel,
  .taxonomy-card,
  .post-toc
    background: rgba(255, 255, 255, 0.74)

  .content-stats strong,
  .archive-entry-title,
  .taxonomy-card > a,
  .tag-cloud-panel a,
  .article-header .post-title,
  .article-meta a,
  .article-nav a.prev,
  .article-nav a.next,
  .toc-title
    color: #101722

  .content-stats span,
  .archive-entry-date,
  .taxonomy-card p,
  .taxonomy-preview a,
  .tag-cloud-panel a small,
  .article-meta,
  .article-tags a,
  .article-nav small,
  .post-toc .tocbot-list a,
  .post-toc .tocbot-list-menu a
    color: #657184

  .friends-panel blockquote
    background: rgba(21, 215, 118, 0.08)
    border-color: rgba(21, 215, 118, 0.26)
    border-left-color: #15d776

  .ins-content img
    border-color: rgba(16, 23, 34, 0.12)
    background: rgba(16, 23, 34, 0.04)

  .article-content figure.highlight
    background: #f0f4f8

  .pagination .current
    color: #061009
    background: #15d776
    border-color: #15d776
    box-shadow: 0 12px 28px rgba(21, 215, 118, 0.18)

  .pagination
    border-top-color: rgba(16, 23, 34, 0.08)
    background: transparent
    box-shadow: none

    a,
    span
      color: #667085
      border-color: rgba(16, 23, 34, 0.12)
      background: #ffffff
      box-shadow: none

    a:hover
      color: #0f9f5a
      border-color: rgba(21, 215, 118, 0.44)
      background: rgba(21, 215, 118, 0.08)

    .space
      background: transparent
      color: #94a3b8
      box-shadow: none

    .disabled
      color: #b5bdc9
      border-color: rgba(16, 23, 34, 0.08)
      background: rgba(255, 255, 255, 0.56)

@media (max-width: 1279px)
  .post-toc
    display: none

@media (max-width: 720px)
  .content-shell,
  .article-shell
    padding: 34px 18px 58px

  .content-hero h1
    font-size: $text-section

  .content-hero p
    font-size: $text-base

  .timeline-panel,
  .content-panel,
  .tag-cloud-panel
    margin-top: 24px

  .timeline-panel,
  .content-panel,
  .tag-cloud-panel
    padding: 18px

  .archive-entry
    grid-template-columns: 1fr
    gap: 6px
    padding: 16px 0

  .archive-entry-title
    white-space: normal

  .archive-entry-date
    justify-self: start

  .taxonomy-grid,
  .ins-content,
  .article-nav
    grid-template-columns: 1fr

  .taxonomy-card
    min-height: 0

  .article-panel
    padding: 24px 18px

  .article-header .post-title
    font-size: $text-section

  .article-nav a.next
    text-align: left

  .pagination
    gap: 6px
    margin-top: 26px
    padding: 18px 0 0
    border-radius: 0

    a,
    span
      min-width: 30px
      height: 32px
      padding: 0 7px
      border-radius: 9px
      font-size: $text-xs

    .extend
      min-width: 32px
      font-size: $text-sm

    .space
      min-width: 18px
      height: 32px
