html
  background: #000
  &::-webkit-scrollbar-thumb
    background-color: rgba(255, 255, 255, 0.24)
    &:hover
      background-color: rgba(255, 255, 255, 0.4)

body
  background: #000
  color: #fff
  letter-spacing: 0.02em

  &:before
    opacity: 1
    z-index: -2
    background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px)
    background-size: 48px 48px
    background-position: center center

  &:after
    content: ''
    position: fixed
    inset: 0
    z-index: -1
    pointer-events: none
    background: radial-gradient(circle at top, rgba(255, 255, 255, 0.08), transparent 36%), linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 32%)

a
  color: #fff
  &:hover
    color: #999

.wrapper
  position: relative

.navbar-actions
  display: flex
  align-items: center
  justify-content: flex-end
  gap: 14px

.navbar,
.navbar-mobile
  border-bottom: 1px solid rgba(255, 255, 255, 0.12)
  background: rgba(0, 0, 0, 0.88)
  backdrop-filter: blur(18px)

.navbar
  position: sticky
  top: 0
  z-index: 20
  height: auto
  line-height: 1.2

  .container
    max-width: 1720px
    padding: 22px 32px
    align-items: center
    gap: 24px

  .header-logo a
    font-size: 16px
    letter-spacing: 0.28em
    text-transform: uppercase
    font-family: $font-family

  .menu
    display: flex
    flex-wrap: wrap
    justify-content: flex-end
    gap: 8px

    a
      display: inline-flex
      align-items: center
      min-height: 42px
      padding: 0 16px
      border: 1px solid transparent
      border-radius: 9999px
      font-size: 12px
      letter-spacing: 0.22em
      text-transform: uppercase
      font-family: $font-family

      &:hover
        border-color: rgba(255, 255, 255, 0.18)
        color: #fff

.theme-toggle
  display: inline-flex
  align-items: center
  justify-content: center
  min-height: 40px
  padding: 0 14px
  border: 1px solid rgba(255, 255, 255, 0.16)
  border-radius: 9999px
  background: transparent
  color: #fff
  font-size: 11px
  letter-spacing: 0.24em
  text-transform: uppercase
  font-family: $font-family
  cursor: pointer
  transition: background 0.24s ease, color 0.24s ease, border-color 0.24s ease

  &:hover
    border-color: rgba(255, 255, 255, 0.32)
    background: rgba(255, 255, 255, 0.08)

.navbar-mobile
  .container
    padding: 18px 20px

    .navbar-header
      display: flex
      align-items: center
      justify-content: space-between

      a
        font-size: 14px
        letter-spacing: 0.24em
        text-transform: uppercase
        font-family: $font-family

      .theme-toggle-mobile
        margin-left: 12px
        min-height: 28px
        padding: 0 10px
        font-size: 10px

    .menu-toggle
      display: inline-flex
      align-items: center
      justify-content: center
      width: 44px
      height: 44px
      border: 1px solid rgba(255, 255, 255, 0.24)
      border-radius: 9999px
      font-size: 18px

    .menu
      padding: 88px 24px 24px
      background: rgba(0, 0, 0, 0.98)

      .menu-item-title
        margin-bottom: 16px
        a
          color: #999
          letter-spacing: 0.24em
          text-transform: uppercase
          font-family: $font-family
          line-height: 1.4

      a.menu-item
        display: flex
        align-items: center
        min-height: 52px
        padding: 0 18px
        margin-bottom: 12px
        border: 1px solid rgba(255, 255, 255, 0.12)
        border-radius: 6px
        color: #fff
        font-size: 13px
        letter-spacing: 0.22em
        text-transform: uppercase
        font-family: $font-family

        &:last-child
          border-bottom: 1px solid rgba(255, 255, 255, 0.12)

      .menu-close
        display: inline-flex
        align-items: center
        justify-content: center
        border: 1px solid rgba(255, 255, 255, 0.24)
        border-radius: 9999px
        color: #fff

.main
  .container
    max-width: 1720px
    margin: 0 auto

.home-page
  .navbar,
  .navbar-mobile
    background: rgba(0, 0, 0, 0.72)
    border-bottom-color: rgba(255, 255, 255, 0.08)
    backdrop-filter: blur(10px)

  .navbar .menu a
    color: rgba(255, 255, 255, 0.68)
    &:hover
      color: #fff
      border-color: rgba(255, 255, 255, 0.12)

.home-shell
  min-height: calc(100vh - 84px)
  display: flex
  align-items: center
  padding-top: 24px
  padding-bottom: 48px

.intro
  width: 100%
  transform: none
  display: grid
  grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr)
  gap: 56px
  align-items: center
  text-align: left

.intro-copy
  max-width: 780px

.intro-kicker
  display: inline-flex
  align-items: center
  min-height: 34px
  padding: 0 14px
  margin-bottom: 24px
  border: 1px solid rgba(255, 255, 255, 0.14)
  border-radius: 9999px
  color: #999
  font-size: 12px
  letter-spacing: 0.28em
  text-transform: uppercase
  font-family: $font-family

.nickname
  display: flex
  flex-direction: column
  gap: 2px
  margin: 0
  font-size: clamp(4.8rem, 10vw, 8.8rem)
  line-height: 0.88
  letter-spacing: 0.08em
  text-transform: uppercase

.intro-summary
  max-width: 640px
  margin-top: 24px
  color: #fff
  font-size: clamp(1.1rem, 2.4vw, 1.5rem)
  line-height: 1.55
  letter-spacing: 0.06em
  text-transform: uppercase
  font-family: $font-family

.description
  max-width: 620px
  margin-top: 18px
  color: rgba(255, 255, 255, 0.58)
  font-size: 16px
  line-height: 1.85

  p
    margin: 0

.intro-actions
  display: flex
  flex-wrap: wrap
  gap: 14px
  margin-top: 34px

.action-btn
  display: inline-flex
  align-items: center
  justify-content: center
  min-height: 46px
  padding: 0 20px
  border: 1px solid rgba(255, 255, 255, 0.22)
  border-radius: 9999px
  color: #fff
  font-size: 13px
  letter-spacing: 0.28em
  text-transform: uppercase
  font-family: $font-family
  transition: background 0.24s ease, color 0.24s ease, border-color 0.24s ease, transform 0.24s ease

  &:hover
    background: #fff
    color: #000
    border-color: #fff
    transform: translateY(-1px)

.action-btn-primary
  border-color: #fff

.action-btn-ghost
  border-color: transparent
  padding-left: 6px
  padding-right: 6px
  min-height: auto

  &:hover
    background: transparent
    color: #999
    transform: none

.intro-telemetry
  display: flex
  flex-wrap: wrap
  gap: 18px
  margin-top: 32px
  color: #999
  font-size: 12px
  letter-spacing: 0.22em
  text-transform: uppercase
  font-family: $font-family
  line-height: 1.6

  span
    display: inline-flex
    align-items: center
    gap: 8px

  strong
    color: #fff
    font-weight: 400

.links
  display: flex
  flex-wrap: wrap
  gap: 10px
  margin-top: 22px

  a
    padding: 0

.link-item
  display: inline-flex
  align-items: center
  justify-content: center
  width: 38px
  height: 38px
  padding: 0
  border: 1px solid rgba(255, 255, 255, 0.08)
  border-radius: 9999px
  color: rgba(255, 255, 255, 0.82)
  font-size: 12px
  letter-spacing: 0.18em
  text-transform: uppercase
  font-family: $font-family

  &:hover
    background: rgba(255, 255, 255, 0.06)
    color: #fff

.link-label
  display: inline-block

.intro-scroll
  margin-top: 26px
  color: rgba(255, 255, 255, 0.5)
  font-size: 11px
  letter-spacing: 0.3em
  text-transform: uppercase
  font-family: $font-family

.intro-visual
  display: flex
  justify-content: flex-end
  margin-top: 24px

.hero-panel
  width: min(100%, 620px)
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: 6px
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01))
  overflow: hidden

.hero-panel-head
  display: flex
  align-items: center
  justify-content: space-between
  gap: 16px
  padding: 16px 20px
  border-bottom: 1px solid rgba(255, 255, 255, 0.08)
  color: #999
  font-size: 11px
  letter-spacing: 0.24em
  text-transform: uppercase
  font-family: $font-family

  span
    display: inline-flex
    align-items: center
    justify-content: center
    text-align: center

.hero-panel-main
  display: grid
  grid-template-columns: minmax(180px, 240px) 1fr
  gap: 20px
  padding: 20px
  align-items: stretch

.avatar
  display: flex
  width: 100%
  padding: 0
  border: 1px solid rgba(255, 255, 255, 0.08)
  aspect-ratio: 1 / 1
  border-radius: 50%
  overflow: hidden
  background: #030303
  align-items: center
  justify-content: center

  img
    width: 100%
    height: 100%
    margin: 0
    object-fit: cover
    border-radius: 50%
    transform: scale(1.16)

.terminal-card
  width: 100%
  border: 1px solid rgba(255, 255, 255, 0.08)
  border-radius: 6px
  overflow: hidden
  background: rgba(255, 255, 255, 0.02)

.terminal-bar
  display: flex
  gap: 10px
  padding: 14px 18px
  border-bottom: 1px solid rgba(255, 255, 255, 0.08)

  span
    width: 10px
    height: 10px
    border-radius: 50%
    background: rgba(255, 255, 255, 0.28)

    &:first-child
      background: #fff

    &:nth-child(2)
      background: #999

.terminal-body
  display: grid
  gap: 10px
  padding: 18px
  color: rgba(255, 255, 255, 0.82)
  font-size: 13px
  line-height: 1.7
  letter-spacing: 0.06em
  font-family: $font-family

.terminal-prefix
  display: inline-block
  width: 18px
  color: #fff

.hero-posts
  display: grid
  gap: 8px
  padding: 0 20px 20px

.hero-posts-title
  margin-bottom: 6px
  color: #999
  font-size: 11px
  letter-spacing: 0.24em
  text-transform: uppercase
  font-family: $font-family

.hero-post-item
  display: grid
  grid-template-columns: 88px 1fr
  gap: 14px
  padding: 12px 0
  border-top: 1px solid rgba(255, 255, 255, 0.08)
  align-items: start

  &:hover
    color: #fff

.hero-post-date
  color: #999
  font-size: 11px
  letter-spacing: 0.2em
  text-transform: uppercase
  font-family: $font-family

.hero-post-name
  font-size: 15px
  line-height: 1.65

.post-wrap
  max-width: 1200px
  margin: 40px auto 56px
  padding: 36px
  background: rgba(255, 255, 255, 0.02)
  border: 1px solid rgba(255, 255, 255, 0.12)
  border-radius: 6px
  backdrop-filter: blur(18px)

  p
    margin: 0

.archive
  h3
    margin: 0 0 32px
    font-size: clamp(2.4rem, 7vw, 5rem)
    line-height: 0.95
    letter-spacing: 0.08em
    text-transform: uppercase

  .archive-item
    display: flex
    align-items: center
    justify-content: space-between
    gap: 24px
    margin-left: 0
    padding: 20px 0
    border-bottom: 1px solid rgba(255, 255, 255, 0.08)

.archive-item-link
  max-width: 72%
  font-size: 20px
  line-height: 1.5

.archive-item-date
  float: none
  font-size: 12px
  letter-spacing: 0.18em
  text-transform: uppercase
  font-family: $font-family

.post-title
  margin-bottom: 18px
  font-size: clamp(2.2rem, 6vw, 4.8rem)
  line-height: 0.98
  letter-spacing: 0.06em
  text-transform: uppercase

.post-meta
  display: grid
  gap: 10px
  padding-top: 10px
  color: #999 !important
  font-size: 12px
  line-height: 1.8
  letter-spacing: 0.16em
  text-transform: uppercase
  font-family: $font-family

  br
    display: none

.post-content
  padding-top: 28px
  text-align: left
  line-height: 1.9
  font-size: 17px
  color: rgba(255, 255, 255, 0.88)

  h2, h3, h4, h5, h6
    margin: 48px 0 18px
    line-height: 1.05
    letter-spacing: 0.06em
    text-transform: uppercase

  h2
    font-size: clamp(1.8rem, 4vw, 3rem)

  h3
    font-size: clamp(1.3rem, 3vw, 2.1rem)

  p
    margin: 14px 0
    color: rgba(255, 255, 255, 0.78)

  ul, ol
    padding-left: 1.5em
    color: rgba(255, 255, 255, 0.78)

  li + li
    margin-top: 8px

  strong
    color: #fff
    font-weight: 400

  a
    border-bottom: 1px solid rgba(255, 255, 255, 0.24)

    &:hover
      color: #fff
      border-color: rgba(255, 255, 255, 0.68)

  code
    padding: 2px 8px
    border-radius: 6px
    background: rgba(255, 255, 255, 0.08)
    color: #fff
    font-family: Consolas, Monaco, Menlo, monospace

  pre
    background: transparent

  figure.highlight
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: 6px
    background: #050505

    .gutter
      color: rgba(255, 255, 255, 0.35)

  blockquote
    margin: 24px 0
    padding: 18px 20px
    color: rgba(255, 255, 255, 0.72)
    background: rgba(255, 255, 255, 0.04)
    border-left: 1px solid rgba(255, 255, 255, 0.26)

  table
    width: 100%
    border-collapse: collapse

    th, td
      padding: 12px 14px
      border: 1px solid rgba(255, 255, 255, 0.12)

  img
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: 6px

  .image-caption:not(:empty)
    color: #999
    border-bottom-color: rgba(255, 255, 255, 0.18)
    font-family: $font-family

.categories-card
  padding: 0 !important

  .card-item
    margin-top: 0 !important
    padding: 0 !important
    border-top: 1px solid rgba(255, 255, 255, 0.08)

    &:first-child
      border-top: 0

  .categories
    width: 100%
    padding: 26px 0

    h3
      margin: 0 0 18px
      font-size: 28px
      letter-spacing: 0.08em
      text-transform: uppercase

.tag-cloud-tags
  display: flex
  flex-wrap: wrap
  gap: 12px
  margin-top: 28px
  padding-top: 0

  a
    margin: 0
    padding: 12px 18px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: 9999px
    font-size: 13px
    letter-spacing: 0.16em
    text-transform: uppercase
    font-family: $font-family

    &:active, &:focus, &:hover
      transform: none
      color: #fff
      background: rgba(255, 255, 255, 0.08)

    small
      color: #999

.pagination
  padding-top: 36px
  gap: 8px

  a, span
    min-width: 40px
    min-height: 40px
    padding: 0 12px
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: 9999px
    color: #999
    font-size: 12px
    letter-spacing: 0.18em
    text-transform: uppercase
    font-family: $font-family
    display: inline-flex
    align-items: center
    justify-content: center

  .page-number
    margin: 0
    color: #999

    &:before, &:after
      display: none

    &.current
      color: #fff
      border-color: rgba(255, 255, 255, 0.3)
      background: rgba(255, 255, 255, 0.08)

.footer
  height: auto
  padding: 28px 0 36px
  border-top: 1px solid rgba(255, 255, 255, 0.1)

.copyright
  color: #999
  font-size: 12px
  letter-spacing: 0.16em
  text-transform: uppercase
  font-family: $font-family

  a
    color: #fff

.light-theme
  background: #f5f7fb

  body
    background: #f5f7fb
    color: #0f172a

    &:before
      background-image: linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px)

    &:after
      background: radial-gradient(circle at top, rgba(148, 163, 184, 0.18), transparent 42%), linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(245, 247, 251, 0))

  a
    color: #0f172a

    &:hover
      color: #334155

  .navbar,
  .navbar-mobile
    border-bottom-color: rgba(15, 23, 42, 0.1)
    background: rgba(255, 255, 255, 0.84)

  .navbar .menu a
    color: #334155

    &:hover
      color: #0f172a
      border-color: rgba(15, 23, 42, 0.12)

  .header-logo a,
  .navbar-mobile .navbar-header a,
  .navbar-mobile .container .menu .menu-item-title a,
  .navbar-mobile .container .menu a.menu-item,
  .menu-toggle,
  .theme-toggle
    color: #0f172a

  .theme-toggle
    border-color: rgba(15, 23, 42, 0.16)

    &:hover
      background: rgba(15, 23, 42, 0.06)
      border-color: rgba(15, 23, 42, 0.26)

  .navbar-mobile .container .menu
    background: rgba(255, 255, 255, 0.98)

  .navbar-mobile .container .menu a.menu-item,
  .navbar-mobile .container .menu .menu-close,
  .navbar-mobile .container .menu-toggle
    border-color: rgba(15, 23, 42, 0.12)

  .home-page .navbar,
  .home-page .navbar-mobile
    background: rgba(255, 255, 255, 0.72)
    border-bottom-color: rgba(15, 23, 42, 0.08)

  .home-page .navbar .menu a
    color: rgba(15, 23, 42, 0.68)

    &:hover
      color: #0f172a
      border-color: rgba(15, 23, 42, 0.12)

  .intro-kicker
    border-color: rgba(15, 23, 42, 0.12)
    color: #64748b

  .nickname,
  .intro-summary
    color: #0f172a

  .description
    color: rgba(15, 23, 42, 0.7)

  .action-btn
    color: #0f172a
    border-color: rgba(15, 23, 42, 0.18)

    &:hover
      background: #0f172a
      color: #f8fafc
      border-color: #0f172a

  .action-btn-primary
    border-color: #0f172a

  .action-btn-ghost
    &:hover
      color: #475569
      background: transparent
      border-color: transparent

  .intro-telemetry,
  .intro-scroll,
  .metric-label,
  .hero-posts-title,
  .hero-post-date,
  .copyright
    color: #64748b

  .intro-telemetry strong
    color: #0f172a

  .link-item
    color: #0f172a
    border-color: rgba(15, 23, 42, 0.12)

    &:hover
      color: #0f172a
      background: rgba(15, 23, 42, 0.04)

  .hero-panel,
  .terminal-card,
  .avatar,
  .post-wrap
    background: rgba(255, 255, 255, 0.82)
    border-color: rgba(15, 23, 42, 0.1)
    backdrop-filter: blur(18px)

  .hero-panel-head,
  .terminal-bar,
  .hero-post-item,
  .footer
    border-color: rgba(15, 23, 42, 0.08)

  .terminal-body,
  .hero-post-name,
  .archive-item-link,
  .post-title,
  .post-content,
  .post-content strong
    color: #0f172a

  .terminal-prefix
    color: #0f172a

  .archive .archive-item
    border-bottom-color: rgba(15, 23, 42, 0.08)

  .archive-item-date,
  .post-meta,
  .post-content p,
  .post-content ul,
  .post-content ol,
  .tag-cloud-tags a small
    color: #64748b

  .post-content a
    border-bottom-color: rgba(15, 23, 42, 0.18)

    &:hover
      color: #0f172a
      border-bottom-color: rgba(15, 23, 42, 0.5)

  .post-content code
    background: #e2e8f0
    color: #0f172a

  .post-content figure.highlight,
  .post-content blockquote,
  .post-content table thead
    background: #eef2f7
    border-color: rgba(15, 23, 42, 0.12)

  .post-content table th,
  .post-content table td,
  .post-content img,
  .categories-card .card-item
    border-color: rgba(15, 23, 42, 0.12)

  .tag-cloud-tags a,
  .pagination a,
  .pagination span
    color: #475569
    border-color: rgba(15, 23, 42, 0.12)

  .tag-cloud-tags a:hover,
  .pagination .page-number.current
    color: #0f172a
    background: rgba(15, 23, 42, 0.06)
    border-color: rgba(15, 23, 42, 0.18)

  .copyright a
    color: #0f172a

@media (max-width: 1279px)
  .navbar .container
    padding-left: 24px
    padding-right: 24px

  .intro
    grid-template-columns: 1fr
    gap: 32px

  .intro-visual
    justify-content: flex-start

  .hero-panel
    width: min(100%, 720px)

  .hero-panel-main
    grid-template-columns: 220px 1fr

@media (max-width: 767px)
  .home-shell
    min-height: auto
    padding-top: 24px
    padding-bottom: 36px

  .nickname
    font-size: clamp(3.4rem, 17vw, 5rem)

  .intro-summary
    font-size: 1rem

  .hero-panel-main
    grid-template-columns: 1fr

  .hero-post-item
    grid-template-columns: 1fr
    gap: 6px

  .hero-post-date
    font-size: 10px

  .description
    font-size: 15px

  .intro-telemetry
    gap: 10px 14px

  .post-wrap
    margin: 24px auto 36px
    padding: 22px 18px

  .archive .archive-item
    flex-direction: column
    align-items: flex-start

  .archive-item-link
    max-width: 100%
    white-space: normal

  .post-title
    font-size: 2.2rem

  .post-content
    font-size: 15px
