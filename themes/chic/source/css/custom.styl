html
  background: #07090d
  &::-webkit-scrollbar-thumb
    background-color: rgba(255, 255, 255, 0.26)
    &:hover
      background-color: rgba(255, 255, 255, 0.42)

body
  min-width: 320px
  background: #07090d
  color: #f7f9fc
  letter-spacing: 0
  font-size: 16px

  &:before
    display: none

  &:after
    content: ''
    position: fixed
    inset: 0
    z-index: -1
    pointer-events: none
    background: radial-gradient(circle at 50% 0%, rgba(43, 255, 143, 0.14), transparent 28%), linear-gradient(180deg, rgba(255,255,255,0.035), transparent 280px)

a
  color: #f7f9fc
  &:hover
    color: #31ec86

.wrapper
  position: relative

.main
  flex: 1
  .container
    max-width: 1130px
    min-height: auto
    margin: 0 auto

$text-xs = 12px
$text-sm = 14px
$text-base = 16px
$text-lg = 18px
$text-xl = 20px
$text-2xl = 24px
$text-section = clamp(30px, 3vw, 36px)
$text-hero = clamp(46px, 5vw, 64px)

.navbar,
.navbar-mobile
  border-bottom: 1px solid rgba(255, 255, 255, 0.08)
  background: rgba(7, 9, 13, 0.88)
  backdrop-filter: blur(18px)

.navbar
  position: sticky
  top: 0
  z-index: 30
  height: auto
  line-height: 1

  .container
    max-width: 1360px
    height: 64px
    padding: 0 28px
    display: flex
    align-items: center
    justify-content: space-between
    gap: 28px

.header-logo a,
.navbar-mobile .navbar-header > a
  display: inline-flex
  align-items: center
  gap: 2px
  color: #f7f9fc
  font-size: $text-xl
  font-weight: 800
  letter-spacing: 0
  text-transform: uppercase

  span
    color: #31ec86

.navbar-actions
  display: flex
  align-items: center
  gap: 18px

.navbar .menu
  display: flex
  align-items: center
  gap: 18px

  a
    display: inline-flex
    align-items: center
    gap: 7px
    padding: 0
    color: rgba(247, 249, 252, 0.62)
    font-size: $text-sm
    font-weight: 600
    line-height: 64px

    .nav-icon
      width: 17px
      height: 17px
      color: rgba(49, 236, 134, 0.72)
      fill: none
      flex: 0 0 auto
      line-height: 1
      stroke: currentColor
      stroke-linecap: round
      stroke-linejoin: round
      stroke-width: 2

    &:hover
      color: #f7f9fc

      .nav-icon
        color: #31ec86

.theme-toggle
  width: 38px
  min-width: 38px
  height: 38px
  display: inline-flex
  align-items: center
  justify-content: center
  padding: 0
  border: 1px solid rgba(255, 255, 255, 0.18)
  border-radius: 50%
  background: #07090d
  color: #ffffff
  cursor: pointer
  transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease

  &:hover
    border-color: rgba(49, 236, 134, 0.72)
    background: #0d1118
    transform: translateY(-1px)

.theme-icon
  display: none
  width: 19px
  height: 19px
  fill: none
  stroke: currentColor
  stroke-linecap: round
  stroke-linejoin: round
  stroke-width: 2

.theme-toggle[data-theme-mode='dark'] .theme-icon-moon,
.theme-toggle[data-theme-mode='light'] .theme-icon-sun
  display: block

.navbar-mobile
  display: none

.home-template
  max-width: 1130px
  margin: 0 auto
  padding: 68px 24px 92px

.home-hero
  min-height: 430px
  display: flex
  flex-direction: column
  align-items: flex-start
  justify-content: center

  h1
    margin: 0
    max-width: 820px
    color: #f7f9fc
    font-size: $text-hero
    line-height: 1.14
    font-weight: 800

.home-eyebrow
  margin: 0 0 18px
  color: #31ec86
  font-size: $text-sm
  font-weight: 800
  letter-spacing: 0.08em
  text-transform: uppercase

.home-subtitle
  max-width: 740px
  margin: 22px 0 0
  color: #a9b3c3
  font-size: $text-lg
  line-height: 1.7

.home-actions
  display: flex
  flex-wrap: wrap
  gap: 14px
  margin-top: 34px

.home-action
  display: inline-flex
  align-items: center
  justify-content: center
  min-width: 214px
  height: 52px
  padding: 0 22px
  border: 1px solid rgba(255, 255, 255, 0.55)
  color: #f7f9fc
  font-size: $text-base
  font-weight: 800

  &:hover
    border-color: #31ec86
    color: #31ec86

  &.is-primary
    border-color: #31ec86
    background: #31ec86
    color: #061009

    &:hover
      background: #62f3a5
      color: #061009

.home-stats
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 14px
  width: 100%
  margin-top: 48px

  div
    padding: 18px 20px
    border: 1px solid rgba(255, 255, 255, 0.12)
    background: rgba(255, 255, 255, 0.035)

  strong
    display: block
    color: #f7f9fc
    font-size: $text-2xl
    line-height: 1.2

  span
    display: block
    margin-top: 8px
    color: #8d98aa
    font-size: $text-sm
    font-weight: 700

.home-section
  margin-top: 76px
  padding-top: 38px
  border-top: 1px solid rgba(255, 255, 255, 0.12)

.home-section-head
  display: flex
  align-items: flex-start
  justify-content: space-between
  gap: 24px
  margin-bottom: 30px

  h2
    margin: 0
    color: #f7f9fc
    font-size: $text-section
    line-height: 1.2
    font-weight: 800

  p
    max-width: 430px
    margin: 0
    color: #909bad
    font-size: $text-base
    line-height: 1.7

.section-kicker
  margin: 0 0 10px !important
  color: #31ec86 !important
  font-size: $text-xs !important
  font-weight: 800
  letter-spacing: 0.08em
  line-height: 1.4 !important
  text-transform: uppercase

.section-more
  flex: 0 0 auto
  color: #f7f9fc
  font-size: $text-sm
  font-weight: 800

  &:hover
    color: #31ec86

.topic-grid
  display: grid
  grid-template-columns: repeat(4, minmax(0, 1fr))
  gap: 18px

.topic-card
  min-height: 260px
  display: flex
  flex-direction: column
  padding: 24px
  border: 1px solid rgba(255, 255, 255, 0.12)
  background: rgba(255, 255, 255, 0.035)

  h3
    margin: 22px 0 0
    color: #f7f9fc
    font-size: $text-xl
    line-height: 1.35
    font-weight: 800

  p
    margin: 14px 0 0
    color: #a9b3c3
    font-size: $text-base
    line-height: 1.7

  a
    margin-top: auto
    padding-top: 22px
    color: #f7f9fc
    font-size: $text-sm
    font-weight: 800

    &:hover
      color: #31ec86

.topic-index
  display: inline-flex
  align-items: center
  justify-content: center
  width: 34px
  height: 34px
  border: 1px solid rgba(255, 255, 255, 0.22)
  color: #31ec86
  font-size: $text-xs
  font-weight: 800

.latest-list
  border-top: 1px solid rgba(255, 255, 255, 0.10)

.latest-row
  min-height: 82px
  display: grid
  grid-template-columns: 136px minmax(0, 1fr) 220px
  align-items: center
  gap: 24px
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)
  color: #f7f9fc

  &:hover
    color: #31ec86

  time
    color: #8d98aa
    font-size: $text-sm
    font-weight: 800

.latest-title
  min-width: 0
  overflow: hidden
  color: inherit
  font-size: $text-lg
  line-height: 1.5
  text-overflow: ellipsis
  white-space: nowrap

.latest-tags
  display: flex
  flex-wrap: wrap
  justify-content: flex-end
  gap: 8px

  em
    display: inline-flex
    max-width: 96px
    overflow: hidden
    padding: 6px 9px
    border: 1px solid rgba(255, 255, 255, 0.12)
    color: #9aa5b6
    font-size: $text-xs
    font-style: normal
    font-weight: 800
    line-height: 1.2
    text-overflow: ellipsis
    white-space: nowrap

.site-link-grid
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 14px

.site-link-card
  display: flex
  flex-direction: column
  min-height: 116px
  padding: 22px
  border: 1px solid rgba(255, 255, 255, 0.12)
  background: rgba(255, 255, 255, 0.03)
  color: #f7f9fc

  strong
    color: inherit
    font-size: $text-lg
    line-height: 1.3

  span
    margin-top: 12px
    color: #9aa5b6
    font-size: $text-sm
    line-height: 1.6

  &:hover
    border-color: rgba(49, 236, 134, 0.6)
    color: #31ec86

.post-wrap,
.archive,
.categories-card,
.tag-cloud
  max-width: 980px
  margin: 56px auto
  padding: 36px
  border: 1px solid rgba(255, 255, 255, 0.12)
  background: rgba(255, 255, 255, 0.03)

.archive h3,
.post-title
  margin: 0 0 28px
  color: #f7f9fc
  font-size: $text-section
  line-height: 1.2
  font-weight: 800

.archive .archive-item
  margin-left: 0
  padding: 18px 0
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)

.archive-item-link
  color: #f7f9fc
  font-size: $text-lg
  line-height: 1.5

.archive-item-date,
.post-meta
  color: #8d98aa
  font-size: $text-sm

.post-content
  color: #d8dee8
  font-size: $text-base
  line-height: 1.9

  h2, h3, h4
    color: #f7f9fc
    line-height: 1.25

  h2
    font-size: $text-2xl

  h3
    font-size: $text-xl

  h4
    font-size: $text-lg

  p, ul, ol
    color: #c4ccd8

  a
    color: #31ec86
    border-bottom: 1px solid rgba(49, 236, 134, 0.34)

  code
    padding: 2px 7px
    background: rgba(255, 255, 255, 0.08)
    color: #f7f9fc
    border-radius: 4px

  figure.highlight,
  blockquote
    border: 1px solid rgba(255, 255, 255, 0.12)
    background: rgba(255, 255, 255, 0.04)

.tag-cloud-tags
  display: flex
  flex-wrap: wrap
  gap: 12px

  a
    margin: 0
    padding: 9px 14px
    border: 1px solid rgba(255, 255, 255, 0.14)
    color: #f7f9fc

    &:hover
      border-color: #31ec86
      color: #31ec86

.footer
  height: auto
  padding: 30px 20px
  border-top: 1px solid rgba(255, 255, 255, 0.08)
  line-height: 1.5

.copyright
  color: #7e8899
  font-size: $text-sm

.light-theme
  background: #f4f7fb

  body
    background: #f4f7fb
    color: #101722

    &:after
      background: radial-gradient(circle at 50% 0%, rgba(49, 236, 134, 0.18), transparent 30%), linear-gradient(180deg, rgba(255,255,255,0.9), transparent 280px)

  a
    color: #101722

  .navbar,
  .navbar-mobile
    background: rgba(255, 255, 255, 0.9)
    border-bottom-color: rgba(16, 23, 34, 0.1)

  .header-logo a,
  .navbar-mobile .navbar-header > a,
  .navbar .menu a,
  .home-hero h1,
  .home-section-head h2,
  .home-stats strong,
  .topic-card h3,
  .latest-title,
  .site-link-card strong,
  .archive h3,
  .post-title
    color: #101722

  .navbar .menu a
    color: #5b6676

  .theme-toggle
    border-color: rgba(16, 23, 34, 0.14)
    background: #ffffff
    color: #101722

    &:hover
      border-color: rgba(21, 215, 118, 0.65)
      background: #ffffff

  .home-subtitle,
  .home-section-head p,
  .home-stats span,
  .topic-card p,
  .latest-row time,
  .latest-tags em,
  .site-link-card span,
  .archive-item-date,
  .post-meta,
  .copyright
    color: #657184

  .home-action
    color: #101722
    border-color: rgba(16, 23, 34, 0.32)

  .home-action.is-primary
    border-color: #15d776
    background: #15d776
    color: #061009

  .home-section,
  .home-stats div,
  .topic-card,
  .latest-list,
  .latest-row,
  .latest-tags em,
  .site-link-card,
  .post-wrap,
  .archive,
  .categories-card,
  .tag-cloud,
  .footer
    border-color: rgba(16, 23, 34, 0.12)

  .post-wrap,
  .archive,
  .categories-card,
  .tag-cloud
    background: rgba(255, 255, 255, 0.72)

  .home-stats div,
  .topic-card,
  .site-link-card
    background: rgba(255, 255, 255, 0.72)

  .latest-title,
  .archive-item-link,
  .post-content,
  .post-content h2,
  .post-content h3,
  .post-content h4
    color: #101722

  .post-content p,
  .post-content ul,
  .post-content ol
    color: #3d4756

  .navbar-mobile .menu
    background: #ffffff

    a.menu-item
      color: #101722
      border-bottom-color: rgba(16, 23, 34, 0.12)

      .nav-icon
        color: #15b966

  .theme-toggle-mobile,
  .menu-toggle,
  .menu-close
    border-color: rgba(16, 23, 34, 0.16)
    background: rgba(16, 23, 34, 0.06)
    color: #101722

@media (max-width: 1023px)
  .navbar
    display: none

  .navbar-mobile
    display: block !important
    position: sticky
    top: 0
    z-index: 40

    .container
      padding: 0
      line-height: 1
      background: transparent

    .navbar-header
      height: 64px
      display: flex
      align-items: center
      justify-content: space-between
      padding: 0 20px

    .menu
      position: fixed
      inset: 0
      left: 100vw
      padding: 92px 24px 28px
      background: #07090d
      transition: left 0.2s ease

      &.active
        left: 0

      a.menu-item
        display: flex
        align-items: center
        gap: 12px
        min-height: 56px
        border-bottom: 1px solid rgba(255, 255, 255, 0.12)
        color: #f7f9fc

        .nav-icon
          width: 22px
          height: 22px
          color: #31ec86
          fill: none
          flex: 0 0 auto
          stroke: currentColor
          stroke-linecap: round
          stroke-linejoin: round
          stroke-width: 2

  .mobile-actions
    display: flex
    align-items: center
    gap: 10px

  .theme-toggle-mobile,
  .menu-toggle,
  .menu-close
    min-width: 42px
    height: 36px
    border: 1px solid rgba(255, 255, 255, 0.18)
    background: rgba(255, 255, 255, 0.08)
    color: #f7f9fc
    font-weight: 800

  .theme-toggle-mobile
    width: 36px
    min-width: 36px
    height: 36px

    .theme-icon
      width: 18px
      height: 18px

  .menu-toggle,
  .menu-close
    padding: 0 14px

  .menu-close
    margin-top: 24px

  .home-template
    padding-top: 42px

  .home-hero
    min-height: 360px

  .topic-grid
    grid-template-columns: repeat(2, minmax(0, 1fr))

  .latest-row
    grid-template-columns: 120px minmax(0, 1fr)

  .latest-tags
    grid-column: 2
    justify-content: flex-start

  .site-link-grid
    grid-template-columns: repeat(2, minmax(0, 1fr))

@media (max-width: 720px)
  .main
    padding-top: 0

  .home-template
    padding-left: 18px
    padding-right: 18px

  .home-hero
    min-height: 0
    padding-top: 28px

  .home-actions
    width: 100%

  .home-action
    width: 100%
    min-width: 0

  .home-stats
    grid-template-columns: 1fr

  .home-section
    margin-top: 56px
    padding-top: 30px

  .home-section-head
    flex-direction: column

  .topic-grid,
  .site-link-grid
    grid-template-columns: 1fr

  .topic-card
    min-height: 0

  .latest-row
    grid-template-columns: 1fr
    gap: 6px
    padding: 18px 0

  .latest-title
    white-space: normal

  .latest-tags
    grid-column: auto
    justify-content: flex-start

  .post-wrap,
  .archive,
  .categories-card,
  .tag-cloud
    margin: 28px auto
    padding: 22px 18px

/* unified inner pages */
.content-shell,
.article-shell
  max-width: 1130px
  margin: 0 auto
  padding: 58px 24px 88px

.content-hero
  padding: 0 0 34px
  border-bottom: 1px solid rgba(255, 255, 255, 0.12)

  h1
    max-width: 760px
    margin: 0
    color: #f7f9fc
    font-size: $text-hero
    line-height: 1.14
    font-weight: 800

  p
    max-width: 720px
    margin: 18px 0 0
    color: #a9b3c3
    font-size: $text-lg
    line-height: 1.7

.content-kicker
  margin: 0 0 16px !important
  color: #31ec86 !important
  font-size: $text-sm !important
  font-weight: 800
  line-height: 1.4 !important
  letter-spacing: 0.08em
  text-transform: uppercase

.content-stats
  display: flex
  flex-wrap: wrap
  gap: 12px
  margin-top: 26px

  span
    display: inline-flex
    align-items: baseline
    gap: 8px
    min-height: 38px
    padding: 0 14px
    border: 1px solid rgba(255, 255, 255, 0.12)
    color: #8d98aa
    font-size: $text-sm
    font-weight: 700

  strong
    color: #f7f9fc
    font-size: $text-xl
    line-height: 1

.timeline-panel,
.content-panel,
.tag-cloud-panel
  margin-top: 34px
  border: 1px solid rgba(255, 255, 255, 0.12)
  background: rgba(255, 255, 255, 0.03)

.timeline-panel
  padding: 10px 28px 28px

.archive-year
  margin: 34px 0 10px
  color: #31ec86
  font-size: $text-2xl
  line-height: 1.2
  font-weight: 800

.archive-entry
  min-height: 74px
  display: grid
  grid-template-columns: minmax(0, 1fr) 128px
  align-items: center
  gap: 24px
  border-bottom: 1px solid rgba(255, 255, 255, 0.10)

  &:last-of-type
    border-bottom: 0

.archive-entry-title
  min-width: 0
  overflow: hidden
  color: #f7f9fc
  font-size: $text-lg
  line-height: 1.55
  text-overflow: ellipsis
  white-space: nowrap

  &:hover
    color: #31ec86

.archive-entry-date
  justify-self: end
  color: #8d98aa
  font-size: $text-sm
  font-weight: 800

.taxonomy-grid
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 18px
  margin-top: 34px

.taxonomy-card
  min-height: 238px
  display: flex
  flex-direction: column
  padding: 24px
  border: 1px solid rgba(255, 255, 255, 0.12)
  background: rgba(255, 255, 255, 0.03)

  > a
    display: block
    color: #f7f9fc

    &:hover
      color: #31ec86

  h2
    margin: 18px 0 0
    color: inherit
    font-size: $text-2xl
    line-height: 1.25

  p
    margin: 12px 0 0
    color: #9aa5b6
    font-size: $text-base
    line-height: 1.7

.taxonomy-count
  display: inline-flex
  align-items: center
  min-height: 32px
  padding: 0 10px
  border: 1px solid rgba(49, 236, 134, 0.38)
  color: #31ec86
  font-size: $text-sm
  font-weight: 800

.taxonomy-preview
  display: grid
  gap: 10px
  margin-top: auto
  padding-top: 22px

  a
    min-width: 0
    overflow: hidden
    color: #a9b3c3
    font-size: $text-sm
    line-height: 1.5
    text-overflow: ellipsis
    white-space: nowrap

    &:hover
      color: #31ec86

.tag-cloud-panel
  display: flex
  flex-wrap: wrap
  gap: 12px
  padding: 26px

  a
    display: inline-flex
    align-items: center
    gap: 10px
    min-height: 40px
    padding: 0 14px
    border: 1px solid rgba(255, 255, 255, 0.12)
    color: #f7f9fc
    font-size: $text-base
    font-weight: 700

    &:hover
      border-color: rgba(49, 236, 134, 0.7)
      color: #31ec86

    small
      color: #8d98aa
      font-size: $text-xs
      font-weight: 800

.content-panel
  padding: 34px

.readable-page
  max-width: 860px

.ins-content
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 18px
  user-select: none

  p
    margin: 0
    display: contents

  img
    display: block
    width: 100%
    height: 100%
    aspect-ratio: 4 / 3
    object-fit: cover
    border: 1px solid rgba(255, 255, 255, 0.14)
    background: rgba(255, 255, 255, 0.04)

.friends-panel blockquote
  margin: 0
  padding: 20px 22px
  border: 1px solid rgba(49, 236, 134, 0.24)
  border-left: 3px solid #31ec86
  background: rgba(49, 236, 134, 0.06)

.article-shell
  max-width: 980px

.article-panel
  max-width: none
  margin: 0
  padding: 42px

.article-header
  padding-bottom: 30px
  border-bottom: 1px solid rgba(255, 255, 255, 0.12)

  .post-title
    margin: 0
    color: #f7f9fc
    font-size: clamp(34px, 4vw, 52px)
    line-height: 1.18
    font-weight: 800

.article-meta
  display: flex
  flex-wrap: wrap
  gap: 10px 18px
  margin-top: 22px
  color: #8d98aa
  font-size: $text-sm
  line-height: 1.7

  a
    color: #f7f9fc

    &:hover
      color: #31ec86

.article-tags
  display: flex
  flex-wrap: wrap
  gap: 10px
  margin-top: 20px

  a
    display: inline-flex
    align-items: center
    min-height: 34px
    padding: 0 11px
    border: 1px solid rgba(255, 255, 255, 0.12)
    color: #a9b3c3
    font-size: $text-sm
    font-weight: 700

    &:hover
      border-color: rgba(49, 236, 134, 0.7)
      color: #31ec86

.article-content
  padding-top: 34px

  > h1:first-child
    display: none

  h2
    margin: 44px 0 16px
    padding-top: 8px

  h3
    margin: 34px 0 14px

  p
    margin: 16px 0
    line-height: 1.9

  ul, ol
    margin: 16px 0
    padding-left: 1.4em
    line-height: 1.9

  li + li
    margin-top: 8px

  figure.highlight
    margin: 22px 0
    overflow-x: auto
    background: #05080c

    table
      width: auto
      min-width: 100%

    pre
      margin: 0
      padding: 14px 16px
      line-height: 1.7

  blockquote
    margin: 24px 0
    padding: 18px 22px
    border-left: 3px solid #31ec86

  table
    display: block
    width: 100%
    overflow-x: auto
    border-collapse: collapse

  th, td
    padding: 10px 12px

  img
    margin: 24px auto

.article-copyright
  margin-top: 34px
  padding: 18px 20px
  border: 1px solid rgba(255, 255, 255, 0.10)
  color: #9aa5b6

.article-nav
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 14px
  margin-top: 32px

  a.prev,
  a.next
    float: none
    min-height: 98px
    display: flex
    flex-direction: column
    justify-content: center
    padding: 18px 20px
    border: 1px solid rgba(255, 255, 255, 0.12)
    color: #f7f9fc
    font-size: $text-base
    font-weight: 800
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease

    &:before,
    &:after
      display: none

    &:hover
      border-color: rgba(49, 236, 134, 0.7)
      color: #31ec86
      transform: translateY(-2px)

    small
      margin-bottom: 8px
      color: #8d98aa
      font-size: $text-xs
      font-weight: 800

    span
      max-width: none
      width: auto
      line-height: 1.5
      white-space: normal

  a.next
    text-align: right

.post-toc
  position: fixed
  top: 88px
  right: 24px
  width: 220px
  padding: 16px
  border: 1px solid rgba(255, 255, 255, 0.12)
  background: rgba(7, 9, 13, 0.86)
  backdrop-filter: blur(16px)
  font-size: $text-sm

.toc-title
  margin-bottom: 12px
  color: #f7f9fc
  font-size: $text-sm
  font-weight: 800

.post-toc .tocbot-list
  max-height: 52vh
  overflow: auto

  ul
    list-style: none
    padding-left: 0

  li
    margin: 6px 0

  a
    color: #9aa5b6
    line-height: 1.5

    &:hover
      color: #31ec86

.post-toc .is-active-link
  color: #31ec86

.post-toc .tocbot-list-menu
  display: flex
  gap: 10px
  margin-top: 14px

  a
    color: #8d98aa
    font-size: $text-xs
    font-weight: 800
    cursor: pointer

    &:hover
      color: #31ec86

.pagination
  display: flex
  flex-wrap: wrap
  justify-content: center
  align-items: center
  gap: 12px
  width: 100%
  margin-top: 32px
  padding: 18px 0 2px

  a,
  span
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 40px
    height: 40px
    padding: 0 12px
    border: 1px solid rgba(255, 255, 255, 0.16)
    border-radius: 6px
    background: rgba(255, 255, 255, 0.04)
    color: #8e9aab
    font-size: $text-sm
    font-weight: 800
    line-height: 1
    text-decoration: none
    box-shadow: none
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease

  .extend
    font-size: $text-base
    font-weight: 800

  a:hover
    color: #31ec86
    border-color: rgba(49, 236, 134, 0.62)
    background: rgba(49, 236, 134, 0.08)

  a:focus-visible
    outline: 2px solid rgba(49, 236, 134, 0.78)
    outline-offset: 2px

  .space
    min-width: 28px
    height: 40px
    padding: 0
    border-color: transparent
    background: transparent
    box-shadow: none
    color: #7a8596
    cursor: default
    pointer-events: none

  .current
    color: #061009
    background: #31ec86
    border-color: #31ec86
    box-shadow: none
    cursor: default

  .disabled
    color: #4f5968
    border-color: rgba(255, 255, 255, 0.08)
    background: rgba(255, 255, 255, 0.025)
    cursor: not-allowed
    pointer-events: none

.light-theme
  .content-hero
    border-bottom-color: rgba(16, 23, 34, 0.12)

    h1
      color: #101722

    p
      color: #657184

  .content-stats span,
  .timeline-panel,
  .content-panel,
  .tag-cloud-panel,
  .taxonomy-card,
  .archive-entry,
  .tag-cloud-panel a,
  .article-header,
  .article-tags a,
  .article-copyright,
  .article-nav a.prev,
  .article-nav a.next,
  .pagination a,
  .pagination span,
  .post-toc
    border-color: rgba(16, 23, 34, 0.12)

  .timeline-panel,
  .content-panel,
  .tag-cloud-panel,
  .taxonomy-card,
  .post-toc
    background: rgba(255, 255, 255, 0.74)

  .content-stats strong,
  .archive-entry-title,
  .taxonomy-card > a,
  .tag-cloud-panel a,
  .article-header .post-title,
  .article-meta a,
  .article-nav a.prev,
  .article-nav a.next,
  .toc-title
    color: #101722

  .content-stats span,
  .archive-entry-date,
  .taxonomy-card p,
  .taxonomy-preview a,
  .tag-cloud-panel a small,
  .article-meta,
  .article-tags a,
  .article-nav small,
  .post-toc .tocbot-list a,
  .post-toc .tocbot-list-menu a
    color: #657184

  .friends-panel blockquote
    background: rgba(21, 215, 118, 0.08)
    border-color: rgba(21, 215, 118, 0.26)
    border-left-color: #15d776

  .ins-content img
    border-color: rgba(16, 23, 34, 0.12)
    background: rgba(16, 23, 34, 0.04)

  .article-content figure.highlight
    background: #f0f4f8

  .pagination .current
    color: #061009
    background: #15d776
    border-color: #15d776
    box-shadow: none

  .pagination
    a,
    span
      background: #ffffff
      color: #667085
      border-color: rgba(16, 23, 34, 0.14)
      box-shadow: none

    a:hover
      color: #0f172a
      border-color: rgba(21, 215, 118, 0.62)
      background: rgba(21, 215, 118, 0.08)

    .space
      background: transparent
      color: #94a3b8
      box-shadow: none

    .disabled
      color: #b5bdc9
      border-color: rgba(16, 23, 34, 0.08)
      background: rgba(16, 23, 34, 0.03)

@media (max-width: 1279px)
  .post-toc
    display: none

@media (max-width: 720px)
  .content-shell,
  .article-shell
    padding: 34px 18px 58px

  .content-hero h1
    font-size: $text-section

  .content-hero p
    font-size: $text-base

  .timeline-panel,
  .content-panel,
  .tag-cloud-panel
    margin-top: 24px

  .timeline-panel,
  .content-panel,
  .tag-cloud-panel
    padding: 18px

  .archive-entry
    grid-template-columns: 1fr
    gap: 6px
    padding: 16px 0

  .archive-entry-title
    white-space: normal

  .archive-entry-date
    justify-self: start

  .taxonomy-grid,
  .ins-content,
  .article-nav
    grid-template-columns: 1fr

  .taxonomy-card
    min-height: 0

  .article-panel
    padding: 24px 18px

  .article-header .post-title
    font-size: $text-section

  .article-nav a.next
    text-align: left

  .pagination
    gap: 8px
    margin-top: 26px
    padding-top: 16px

    a,
    span
      min-width: 34px
      height: 34px
      padding: 0 9px
      border-radius: 6px
      font-size: $text-xs

    .extend
      font-size: $text-sm

    .space
      min-width: 22px
      height: 34px
