:root
  color-scheme dark
  --canvas: #292a2d
  --surface: #333438
  --text: #e4e4e6
  --muted: #acaeb5
  --line: #494b51
  --accent: #c4d6f4
  --accent-surface: #353940
  --code: #242528
  --keyword: #e5a5bb
  --literal: #bdd49f
  --number: #eac99d
  --sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif
  --display: var(--sans)
  --mono: 'SFMono-Regular', Consolas, monospace
  --gutter: clamp(20px, 4vw, 44px)

:root[data-theme='light']
  color-scheme light
  --canvas: #fff
  --surface: #f5f5f6
  --text: #25262a
  --muted: #60636b
  --line: #dedfe3
  --accent: #28527c
  --accent-surface: #eef1f5
  --code: #f5f5f6
  --keyword: #903456
  --literal: #4a632d
  --number: #81521f

*
  box-sizing border-box

html
  scroll-padding-top 24px

body
  margin 0
  background var(--canvas)
  color var(--text)
  font 400 16px/1.6 var(--sans)
  overflow-wrap anywhere

[hidden]
  display none !important

a
  color inherit
  text-decoration none

a:hover
  color var(--accent)

button
  color inherit
  font inherit
  cursor pointer

:focus-visible
  outline 2px solid var(--accent)
  outline-offset 4px

h1, h2, h3, p
  margin 0

img
  max-width 100%
  height auto

.skip-link
  position fixed
  top 10px
  left 10px
  z-index 5
  padding 8px 14px
  background var(--canvas)
  transform translateY(-160%)

  &:focus
    transform none
