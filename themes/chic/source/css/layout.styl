.site-frame
  min-height 100vh

.site-body
  display flex
  flex-direction column
  min-height calc(100vh - 64px)

.site-header
  position relative
  z-index 2
  display flex
  gap 24px
  align-items center
  width 100%
  max-width 1240px
  min-height 64px
  margin-inline auto
  padding-inline var(--gutter)

.site-brand
  font-weight 600
  white-space nowrap

.site-navigation
  display flex
  flex-wrap wrap
  align-items center
  gap 20px
  margin-left auto
  font-size 14px

  a
    padding-block 5px

  a[aria-current]
    text-decoration underline
    text-underline-offset 5px

.site-controls
  display flex
  gap 12px
  margin-left auto

  button
    padding 5px 0
    border 0
    background transparent
    color var(--muted)
    font-size 13px
    white-space nowrap

    &:hover
      color var(--accent)

.site-navigation + .site-controls
  margin-left 0

.site-main
  flex 1
  width 100%
  max-width calc(740px + var(--gutter) * 2)
  padding 48px var(--gutter) 68px
  margin-inline auto

.site-main.article-main
  max-width calc(720px + var(--gutter) * 2)

.site-footer
  padding 19px var(--gutter)
  text-align center
  color var(--muted)
  font-size 13px

.page-heading
  margin-bottom 28px

  h1
    font-size clamp(1.7rem, 4vw, 2.125rem)
    line-height 1.25

  p, > a
    color var(--muted)
    font-size 14px

  p
    margin-top 8px

  > a
    display inline-block
    margin-bottom 12px
    color var(--accent)

.profile-main
  display grid
  place-items center
  padding-block 40px

.profile
  width 100%
  max-width 580px
  padding-bottom clamp(8px, 5vh, 52px)
  text-align center

  h1
    margin-top 18px
    font-size clamp(1.75rem, 5vw, 2.15rem)
    line-height 1.2

.profile-avatar
  display inline-block
  border-radius 50%

  img
    display block
    width 128px
    height 128px
    object-fit cover
    border-radius 50%

@media (hover: hover) and (prefers-reduced-motion: no-preference)
  .profile-avatar img
    pointer-events none
    transition transform .5s ease

  .profile-avatar:hover img
    transform rotate(360deg) scale(1.12)

.profile-description
  margin-top 14px
  color var(--muted)
  line-height 1.75

.profile-links
  display flex
  justify-content center
  flex-wrap wrap
  gap 22px
  margin-top 17px
  font-size 14px

  a
    text-decoration underline
    text-underline-offset 4px

@media (max-width: 780px)
  .site-body
    min-height calc(100vh - 56px)

  .site-header
    display grid
    grid-template-columns minmax(0, 1fr) auto
    gap 0 14px
    min-height 56px
    padding-block 9px

  .site-navigation
    grid-column 1 / -1
    grid-row 2
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 4px 18px
    margin 8px 0 0
    padding-top 7px
    border-top 1px solid var(--line)

  .site-main:not(.profile-main)
    padding-top 34px
