<header class="page-heading">
  <h1><% if (page.year) { %><%= page.year %> 年<% if (page.month) { %><%= page.month %> 月<% } %><% } %>文章归档</h1>
  <% if (!page.year) { %><p><%= site.posts.length %> 篇文章</p><% } %>
</header>

<div class="archive-years">
  <%
    const years = new Map();
    page.posts.forEach(function (entry) {
      const year = entry.date.year();
      if (!years.has(year)) years.set(year, []);
      years.get(year).push(entry);
    });
  %>
  <% years.forEach(function (entries, year) { %>
    <section class="archive-year">
      <h2><%= year %></h2>
      <ul class="post-list">
        <% entries.forEach(function (entry) { %>
          <%- partial('_partial/post-row', { entry: entry }) %>
        <% }); %>
      </ul>
    </section>
  <% }); %>
</div>
<%- partial('_partial/paginator') %>
