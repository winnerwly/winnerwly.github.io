<% if (is_category()) { %>
  <%- partial('_page/taxonomy', {
    indexPath: '/category/',
    indexLabel: '全部分类',
    term: page.category,
    posts: page.posts.sort('date', -1)
  }) %>
<% } else { %>
  <header class="page-heading">
    <h1>分类归档</h1>
    <p><%= site.categories.length %> 个分类 · <%= site.posts.length %> 篇文章</p>
  </header>
  <%
    const categories = site.categories.toArray().map(function (category) {
      return { category: category, latest: category.posts.sort('date', -1).toArray().slice(0, 3) };
    });
    categories.sort(function (a, b) {
      const latestA = a.latest[0] ? a.latest[0].date.valueOf() : 0;
      const latestB = b.latest[0] ? b.latest[0].date.valueOf() : 0;
      return latestB - latestA || a.category.name.localeCompare(b.category.name);
    });
  %>
  <div class="category-grid">
    <% categories.forEach(function (item) { %>
      <section class="category-entry">
        <h2><a href="<%= url_for(item.category.path) %>"><%= item.category.name %><span><%= item.category.posts.length %> 篇 ↗</span></a></h2>
        <ul>
          <% item.latest.forEach(function (entry) { %>
            <li><a href="<%= url_for(entry.path) %>"><%= entry.title %></a></li>
          <% }); %>
        </ul>
      </section>
    <% }); %>
  </div>
<% } %>
