<% if (is_tag()) { %>
  <%- partial('_page/taxonomy', {
    indexPath: '/tag/',
    indexLabel: '全部标签',
    term: page.tag,
    posts: page.posts
  }) %>
<% } else { %>
  <header class="page-heading">
    <h1>标签索引</h1>
    <p><%= site.tags.length %> 个标签 · <%= site.posts.length %> 篇文章</p>
  </header>
  <ul class="tag-index">
    <% site.tags.sort('name').forEach(function (tag) { %>
      <li><a href="<%= url_for(tag.path) %>"><%= tag.name %><span><%= tag.posts.length %></span></a></li>
    <% }); %>
  </ul>
<% } %>
