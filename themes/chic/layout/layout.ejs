<!DOCTYPE html>
<html lang="<%= config.language %>">

<head>
    <%- partial('_partial/head',{cache: true}) %>

    <style type="text/css">
        @keyframes loading-item {
            0% {
                top: 96px;
                left: 96px;
                width: 0;
                height: 0;
                opacity: 1;
            }

            100% {
                top: 18px;
                left: 18px;
                width: 156px;
                height: 156px;
                opacity: 0;
            }
        }

        .loading-item div {
            position: absolute;
            border-width: 4px;
            border-style: solid;
            opacity: 1;
            border-radius: 50%;
            animation: loading-item 1s cubic-bezier(0, 0.2, 0.8, 1) infinite;
        }

        .loading-item div:nth-child(1) {
            border-color: #e90c59
        }

        .loading-item div:nth-child(2) {
            border-color: #46dff0;
            animation-delay: -0.5s;
        }

        .loading-box {
            width: 200px;
            height: 200px;
            display: inline-block;
            overflow: hidden;
            background: #ffffff;
        }

        .loading-item {
            width: 100%;
            height: 100%;
            top: 50%;
            left: 50%;
            margin-top: -100px;
            margin-left: -100px;
            position: absolute;
            transform: translateZ(0) scale(1);
            backface-visibility: hidden;
            transform-origin: 0 0;
            /* see note above */
        }

        .loading-item div {
            box-sizing: content-box;
        }

        /* generated by https://loading.io/ */
    </style>
</head>

<body>

    <div id="loading" class="loading-box">
        <div class="loading-item">
            <div></div>
            <div></div>
        </div>
    </div>
    <div style="display: none;" id="content" class="wrapper">
        <%- partial('_partial/header',{cache: true}) %>
        <div class="main">
            <%- body %>
        </div>
        <%- partial('_partial/footer',{cache: true}) %>
    </div>
</body>
<script>
    const loading = document.getElementById('loading')
    const content = document.getElementById('content')

    window.onload = function () {
        loading.style.display = 'none'
        content.style.display = 'block'
    }
</script>

</html>
