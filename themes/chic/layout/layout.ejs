<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>
  <a class="skip-link" href="#content">跳到正文</a>
  <div class="site-frame">
    <%- partial('_partial/header') %>
    <div class="site-body">
      <main id="content" class="site-main<%= is_home_first_page() ? ' profile-main' : '' %><%= is_post() ? ' article-main' : '' %>" tabindex="-1">
        <%- body %>
      </main>
      <%- partial('_partial/footer') %>
    </div>
  </div>
</body>
</html>
