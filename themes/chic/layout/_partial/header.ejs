<%
  const navItems = [
    { label: '首页', path: '/', active: is_home() },
    { label: '文章', path: '/archives/', active: is_archive() || is_post() },
    { label: '分类', path: '/category/', active: is_category() || is_current('/category/') },
    { label: '标签', path: '/tag/', active: is_tag() || is_current('/tag/') },
    { label: '照片墙', path: '/ins/', active: is_current('/ins/') },
    { label: '关于', path: '/about/', active: is_current('/about/') },
    { label: '友链', path: '/friends/', active: is_current('/friends/') }
  ];
%>
<header class="site-header">
  <a class="site-brand" href="<%= url_for('/') %>">
    <%= theme.navname %>
  </a>

  <nav class="site-navigation" id="site-navigation" aria-label="主导航">
    <% navItems.forEach(function (item) { %>
      <a href="<%= url_for(item.path) %>"<% if (item.active) { %> aria-current="<%= is_current(item.path, true) ? 'page' : 'true' %>"<% } %>><%= item.label %></a>
    <% }); %>
  </nav>

  <div class="site-controls">
    <button id="theme-toggle" class="theme-toggle" type="button" hidden>切换主题</button>
    <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden>菜单</button>
  </div>
</header>
